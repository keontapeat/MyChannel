<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications (watchOS — via iOS companion) -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- App Groups — shared data with iOS companion -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.keontapeat.MyChannelApp</string>
	</array>

	<!-- WatchKit companion app bundle identifier -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:mychannel.live</string>
	</array>

	<!-- Healthkit-style complication data protection -->
	<key>com.apple.developer.default-data-protection</key>
	<string>NSFileProtectionComplete</string>
</dict>
</plist>
