# Environment Configuration for MyChannel Services

# Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-change-this-in-production

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Storage Buckets
INGEST_BUCKET=mychannel-ingest
OUTPUT_BUCKET=mychannel-videos
THUMBNAIL_BUCKET=mychannel-thumbnails

# Pub/Sub Topics
EVENTS_TOPIC=video-events
NOTIFICATIONS_TOPIC=notifications

# CORS Configuration
CORS_ORIGIN=https://yourdomain.com

# Service URLs (for inter-service communication)
AUTH_SERVICE_URL=https://mychannel-auth-xyz.run.app
CONTENT_SERVICE_URL=https://mychannel-content-xyz.run.app
UPLOAD_SERVICE_URL=https://mychannel-upload-xyz.run.app
TRANSCODE_SERVICE_URL=https://mychannel-transcode-xyz.run.app
EVENTS_SERVICE_URL=https://mychannel-events-xyz.run.app
RECOMMENDATIONS_SERVICE_URL=https://mychannel-recommendations-xyz.run.app

# External API Keys
OPENAI_API_KEY=your-openai-api-key-for-ai-features
GOOGLE_CLOUD_VISION_API_KEY=your-vision-api-key-for-content-moderation

# Email Configuration (for notifications)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Environment
NODE_ENV=development
PORT=8080

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Security
BCRYPT_SALT_ROUNDS=12
SESSION_SECRET=your-session-secret-here

# Feature Flags
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_CONTENT_MODERATION=true
ENABLE_ANALYTICS=true
ENABLE_PUSH_NOTIFICATIONS=true

# Performance
MAX_UPLOAD_SIZE=2147483648
MAX_REQUEST_SIZE=52428800
REQUEST_TIMEOUT=30000

# Development
MOCK_EXTERNAL_SERVICES=false
DEBUG_SQL=false









