FROM node:20-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci || npm install
COPY . .
# Compile even if TypeScript reports type errors (noEmitOnError=false in tsconfig)
RUN (npm run build:content || true)

FROM node:20-alpine
WORKDIR /app
# Install only production deps
COPY --from=builder /app/package*.json ./
RUN npm ci --omit=dev --silent || npm i --omit=dev --silent
# Copy compiled output only
COPY --from=builder /app/dist ./dist
ENV NODE_ENV=production
EXPOSE 8080
CMD ["node","--enable-source-maps","dist/content/main.js"]

