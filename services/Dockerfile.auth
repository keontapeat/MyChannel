FROM node:18-slim

# Install dependencies for bcrypt and other native modules
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install dependencies (include dev for TypeScript build)
RUN npm ci

# Copy source code
COPY auth/ ./auth/

# Build TypeScript
RUN npm run build

# Prune dev dependencies for runtime image
RUN npm prune --omit=dev

# Expose port
EXPOSE 8080

# Set environment variables
ENV NODE_ENV=production
ENV PORT=8080

# Run the auth service
CMD ["node", "dist/auth/main.js"]

