rules_version = '2';

// 🔥 FIREBASE STORAGE SECURITY RULES
// Controls access to videos, thumbnails, profile images, etc.

service firebase.storage {
  match /b/{bucket}/o {
    
    // ========================================
    // 🔐 UPLOAD GUARDS (size + content-type)
    // ========================================
    // YouTube-style abuse prevention: cap every upload and pin the content type
    // so nobody can host arbitrary/malicious files or run up a storage-cost bomb.
    function isImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 15 * 1024 * 1024;        // 15 MB
    }
    function isVideo() {
      return request.resource.contentType.matches('video/.*') &&
             request.resource.size < 2 * 1024 * 1024 * 1024;  // 2 GB
    }
    function isAudio() {
      return request.resource.contentType.matches('audio/.*') &&
             request.resource.size < 500 * 1024 * 1024;       // 500 MB
    }
    function isDocument() {
      return request.resource.size < 25 * 1024 * 1024 &&      // 25 MB
             (request.resource.contentType.matches('application/pdf') ||
              request.resource.contentType.matches('image/.*'));
    }
    function isCaption() {
      return request.resource.size < 5 * 1024 * 1024 &&
             (request.resource.contentType == 'text/vtt' ||
              request.resource.contentType == 'text/plain' ||
              request.resource.contentType == 'application/x-subrip');
    }
    function isAnalyticsExport() {
      return request.resource.size < 25 * 1024 * 1024 &&
             (request.resource.contentType == 'text/csv' ||
              request.resource.contentType == 'application/json' ||
              request.resource.contentType == 'application/pdf');
    }
    function isReportEvidence() {
      return request.resource.size < 100 * 1024 * 1024 &&
             (request.resource.contentType.matches('image/.*') ||
              request.resource.contentType.matches('video/.*'));
    }
    function ownsVideo(videoId) {
      return request.auth != null &&
             (firestore.get(/databases/(default)/documents/videos/$(videoId)).data.creatorId == request.auth.uid ||
              firestore.get(/databases/(default)/documents/videos/$(videoId)).data.userId == request.auth.uid);
    }
    
    // 📺 VIDEO OUTPUTS / LEGACY SOURCES
    // Existing processed renditions remain public. A legacy source.mp4 is private
    // to its owner/admin; new raw uploads use the private temp_uploads namespace.
    match /videos/{userId}/{videoId}/{filename} {
      allow read: if filename != 'source.mp4' ||
                    (request.auth != null &&
                     (request.auth.uid == userId || isAdmin()));
      allow create, update: if request.auth != null &&
                              request.auth.uid == userId && isVideo();
      allow delete: if request.auth != null &&
                      (request.auth.uid == userId || isAdmin());
    }
    
    // 🖼️ THUMBNAILS - Anyone can read, authenticated owner can upload
    match /thumbnails/{userId}/{videoId}/{filename} {
      allow read: if true;  // Public read
      allow write: if request.auth != null && request.auth.uid == userId && isImage();
      allow delete: if request.auth != null && request.auth.uid == userId;  // Owner only
    }
    
    // 👤 PROFILE IMAGES - Anyone can read, authenticated owner can upload
    match /profile_images/{userId}/{filename} {
      allow read: if true;  // Public read
      allow write: if request.auth != null && request.auth.uid == userId && isImage();
      allow delete: if request.auth != null && request.auth.uid == userId;  // Owner only
    }
    
    // 👤 USER AVATARS - Anyone can read. Legacy flat path: bind to uid prefix in
    // filename so a user can't overwrite someone else's avatar.
    match /user-avatars/{filename} {
      allow read: if true;  // Public read
      allow write: if request.auth != null && isImage() &&
                      filename.matches(request.auth.uid + '.*');
      allow delete: if request.auth != null && filename.matches(request.auth.uid + '.*');
    }
    
    // 🎨 BANNER IMAGES - Anyone can read, authenticated owner can upload
    match /banner_images/{userId}/{filename} {
      allow read: if true;  // Public read
      allow write: if request.auth != null && request.auth.uid == userId && isImage();
      allow delete: if request.auth != null && request.auth.uid == userId;  // Owner only
    }
    
    // 🎨 USER BANNERS - Anyone can read (legacy flat path bound to uid prefix)
    match /user-banners/{filename} {
      allow read: if true;  // Public read
      allow write: if request.auth != null && isImage() &&
                      filename.matches(request.auth.uid + '.*');
      allow delete: if request.auth != null && filename.matches(request.auth.uid + '.*');
    }
    
    // 🎬 USER BANNER VIDEOS (path: user-banner-videos/{uid}-{timestamp}.mp4)
    match /user-banner-videos/{filename} {
      allow read: if true;
      allow write: if request.auth != null && isVideo() &&
                      filename.matches(request.auth.uid + '.*');
      allow delete: if request.auth != null && filename.matches(request.auth.uid + '.*');
    }
    
    // 🎬 BANNER VIDEOS - Anyone can read, authenticated owner can upload
    match /banner_videos/{userId}/{filename} {
      allow read: if true;  // Public read
      allow write: if request.auth != null && request.auth.uid == userId && isVideo();
      allow delete: if request.auth != null && request.auth.uid == userId;  // Owner only
    }
    
    // 🎭 FLICKS - Anyone can read, authenticated owner can upload
    match /flicks/{userId}/{flickId} {
      allow read: if true;  // Public read
      allow write: if request.auth != null && request.auth.uid == userId && isVideo();
      allow delete: if request.auth != null && request.auth.uid == userId;  // Owner only
    }
    
    // 🎬 STORIES - Anyone can read; owner-bound upload (image or video, 24h expiry)
    match /stories/{userId}/{storyId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId &&
                      (isImage() || isVideo());
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // 📺 LIVE STREAM THUMBNAILS - Anyone can read, streamers can upload
    match /live_thumbnails/{userId}/{filename} {
      allow read: if true;  // Public read
      allow write: if request.auth != null && request.auth.uid == userId && isImage();
      allow delete: if request.auth != null && request.auth.uid == userId;  // Owner only
    }
    
    // 🎮 VS MATCH PROOF - Participants can upload proof of wins
    match /vs_match_proof/{matchId}/{userId}/{filename} {
      allow read: if true;  // Public read
      allow write: if request.auth != null && request.auth.uid == userId &&
                      (isImage() || isVideo());
      allow delete: if request.auth != null && request.auth.uid == userId;  // Owner only
    }
    
    // 📄 DOCUMENTS (ID verification for KYC) - Private, owner only
    match /documents/{userId}/{filename} {
      allow read: if request.auth != null && request.auth.uid == userId;  // Owner only
      allow write: if request.auth != null && request.auth.uid == userId && isDocument();
      allow delete: if request.auth != null && request.auth.uid == userId;  // Owner only
    }
    
    // 🎵 AUDIO FILES - Anyone can read, authenticated owner can upload
    match /audio/{userId}/{filename} {
      allow read: if true;  // Public read
      allow write: if request.auth != null && request.auth.uid == userId && isAudio();
      allow delete: if request.auth != null && request.auth.uid == userId;  // Owner only
    }
    
    // 📦 DETERMINISTIC RAW VIDEO INGEST - private and owner-bound. The Admin
    // SDK transcode service bypasses these rules when reading the source.
    // Clients may create the source and continue a resumable upload (update)
    // until the trusted `uploads/{videoId}` marker exists. After that marker
    // is written, updates are locked to prevent source-swap races.
    match /temp_uploads/{userId}/{videoId}/{filename} {
      allow read: if request.auth != null &&
                    (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null &&
                      request.auth.uid == userId &&
                      filename == 'source.mp4' && isVideo();
      allow update: if request.auth != null &&
                       request.auth.uid == userId &&
                       filename == 'source.mp4' &&
                       isVideo() &&
                       !firestore.exists(
                         /databases/(default)/documents/uploads/$(videoId)
                       );
      allow delete: if request.auth != null &&
                      (isAdmin() ||
                       (request.auth.uid == userId &&
                        !firestore.exists(
                          /databases/(default)/documents/uploads/$(videoId)
                        )));
    }

    // Legacy temporary uploads remain owner-only and bounded.
    match /temp_uploads/{userId}/{filename} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null &&
                              request.auth.uid == userId && isVideo();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // 🎓 UNIVERSITY CONTENT - Public read, admin write
    match /university/{path=**} {
      allow read: if true;  // Public read
      allow write: if isAdmin();  // Admin only
    }
    
    // 🏆 TOURNAMENT ASSETS - Public read, admin write (was: any authed write)
    match /tournaments/{path=**} {
      allow read: if true;  // Public read
      allow write: if isAdmin();
    }
    
    // 📊 ANALYTICS EXPORTS - owner reads; narrow, capped export formats only
    match /analytics_exports/{userId}/{filename} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId &&
                              isAnalyticsExport();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // 🎨 CUSTOM THUMBNAILS - Anyone can read, creator can upload
    match /custom_thumbnails/{userId}/{filename} {
      allow read: if true;  // Public read
      allow write: if request.auth != null && request.auth.uid == userId && isImage();
      allow delete: if request.auth != null && request.auth.uid == userId;  // Owner only
    }
    
    // 📝 SUBTITLES/CAPTIONS - public read, authoritative video owner write
    match /subtitles/{videoId}/{filename} {
      allow read: if true;
      allow create, update: if (ownsVideo(videoId) || isAdmin()) && isCaption();
      allow delete: if ownsVideo(videoId) || isAdmin();
    }
    
    // 🎬 VIDEO CHAPTER THUMBNAILS - public read, authoritative owner write
    match /chapter_thumbnails/{videoId}/{filename} {
      allow read: if true;
      allow create, update: if (ownsVideo(videoId) || isAdmin()) && isImage();
      allow delete: if ownsVideo(videoId) || isAdmin();
    }
    
    // 💰 PAYMENT RECEIPTS - Owner only
    match /receipts/{userId}/{filename} {
      allow read: if request.auth != null && request.auth.uid == userId;  // Owner only
      allow write: if request.auth != null && request.auth.uid == userId && isDocument();
    }
    
    // 🚨 REPORTED CONTENT - create-only evidence bound to the reporter identity
    match /reported_content/{reportId}/{filename} {
      allow read: if request.auth != null && isAdmin();
      allow create: if request.auth != null &&
                      request.resource.metadata.reporterId == request.auth.uid &&
                      isReportEvidence();
      allow update: if false;
      allow delete: if request.auth != null && isAdmin();
    }
    
    // ========================================
    // 🎵 MUSIC PLATFORM STORAGE
    // ========================================

    // 🎵 MUSIC MASTERS - private source audio for the owning artist/admin.
    // Public playback is served only from trusted backend-generated renditions.
    match /music/{userId}/tracks/{filename} {
      allow read: if request.auth != null &&
                    (request.auth.uid == userId || isAdmin());
      allow create, update: if request.auth != null &&
                              request.auth.uid == userId && isAudio();
      allow delete: if request.auth != null &&
                      (request.auth.uid == userId || isAdmin());
    }

    // 🎨 MUSIC ARTWORK - public, tokenized renditions written by trusted API only
    match /music/{userId}/artwork/{filename} {
      allow read: if true;
      allow write, delete: if false;
    }

    // 📦 MUSIC CHUNKED UPLOAD TEMP - reassembled server-side, then deleted
    match /music/temp/{userId}/{trackId}/{filename} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null &&
                      request.auth.uid == userId && isAudio();
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 🎚️ MUSIC RENDITIONS - generated by trusted backend transcoders only.
    // Admin SDK service writers bypass Storage rules.
    match /music/{userId}/renditions/{trackId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // 🎯 DEFAULT - Deny all for security
    match /{allPaths=**} {
      allow read, write: if false;  // Explicit deny for uncovered paths
    }
  }
  
  // HELPER FUNCTIONS
  function isAdmin() {
    return request.auth != null && 
           (request.auth.token.admin == true ||
            (request.auth.token.email_verified == true &&
             (request.auth.token.email == 'keontapeat@mychannel.live' ||
              request.auth.token.email == 'keontapeat@gmail.com')));
  }
}
