## 🚩 FEATURE FLAGS & A/B TESTING

### Feature Flag System
```swift
// ✅ CORRECT: Feature flags for A/B testing

class FeatureFlagManager {
    static let shared = FeatureFlagManager()
    
    private var flags: [String: Bool] = [:]
    private var experiments: [String: String] = [:]
    
    private init() {
        loadFlags()
    }
    
    // Check if feature is enabled
    func isEnabled(_ feature: Feature) -> Bool {
        flags[feature.rawValue] ?? feature.defaultValue
    }
    
    // Get experiment variant
    func getVariant(_ experiment: Experiment) -> String {
        experiments[experiment.rawValue] ?? experiment.defaultVariant
    }
    
    // Load flags from remote
    func loadFlags() {
        Task {
            do {
                let remoteFlags = try await fetchRemoteFlags()
                flags = remoteFlags
            } catch {
                print("🚨 [FeatureFlags] Failed to load: \(error)")
            }
        }
    }
    
    private func fetchRemoteFlags() async throws -> [String: Bool] {
        // Fetch from Firebase Remote Config or your backend
        return [
            "new_video_player": true,
            "enhanced_search": false,
            "live_streaming_v2": true
        ]
    }
}

enum Feature: String {
    case newVideoPlayer = "new_video_player"
    case enhancedSearch = "enhanced_search"
    case liveStreamingV2 = "live_streaming_v2"
    
    var defaultValue: Bool {
        switch self {
        case .newVideoPlayer: return false
        case .enhancedSearch: return false
        case .liveStreamingV2: return false
        }
    }
}

enum Experiment: String {
    case homepageLayout = "homepage_layout"
    case thumbnailStyle = "thumbnail_style"
    
    var defaultVariant: String {
        switch self {
        case .homepageLayout: return "control"
        case .thumbnailStyle: return "standard"
        }
    }
}

// Usage
struct VideoPlayerView: View {
    var body: some View {
        if FeatureFlagManager.shared.isEnabled(.newVideoPlayer) {
            NewVideoPlayer()
        } else {
            LegacyVideoPlayer()
        }
    }
}
