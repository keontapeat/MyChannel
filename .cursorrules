            .frame(width: 375, height: 200)
        
        assertSnapshot(matching: view, as: .image)
    }
    
    func testVideoCard_AllAccessibilitySizes() {
        let video = Video.sampleVideos[0]
        
        for sizeCategory in ContentSizeCategory.allCases {
            let view = VideoCardView(video: video)
                .frame(width: 375, height: 200)
                .environment(\.sizeCategory, sizeCategory)
            
            assertSnapshot(matching: view, as: .image, named: "\(sizeCategory)")
        }
    }
}
