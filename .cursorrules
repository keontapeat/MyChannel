### 🔧 COMMON iOS BUGS & FIXES

#### Retain Cycles
```swift
// ❌ PROBLEM: View model never deallocates
class VideoViewModel: ObservableObject {
    var completion: (() -> Void)?
    
    func loadVideos() {
        Task {
            let videos = await fetch()
            self.completion?()  // Strong capture!
        }
    }
}

// ✅ FIX: Use weak self
func loadVideos() {
    Task { [weak self] in
        guard let self = self else { return }
        let videos = await fetch()
        self.completion?()
    }
}

// ❌ PROBLEM: Delegate cycle
class VideoPlayer {
    var delegate: VideoPlayerDelegate?  // Should be weak!
}

// ✅ FIX: Weak delegate
weak var delegate: VideoPlayerDelegate?
```

#### Main Thread Violations
```swift
// ❌ PROBLEM: UI update from background thread
Task.detached {
    let videos = await fetchVideos()
    self.videos = videos  // Crash if @Published!
}

// ✅ FIX: Use MainActor
Task.detached {
    let videos = await fetchVideos()
    await MainActor.run {
        self.videos = videos
    }
}

// Or better: Use async/await on @MainActor class
@MainActor
class VideoViewModel: ObservableObject {
    @Published var videos: [Video] = []
    
    func loadVideos() async {
        videos = await fetchVideos()  // Already on main!
    }
}
```

#### Force Unwrap Crashes
```swift
// ❌ PROBLEM: Force unwrap nil
let url = URL(string: urlString)!  // Crashes if invalid
let user = users.first!  // Crashes if empty

// ✅ FIX: Safe unwrapping
guard let url = URL(string: urlString) else {
    print("🚨 Invalid URL: \(urlString)")
    return
}

guard let user = users.first else {
    print("⚠️ No users found")
    return
}

// Or use optional chaining
let name = users.first?.name ?? "Unknown"
```

#### Index Out of Bounds
```swift
// ❌ PROBLEM: Array index crash
let video = videos[index]  // Crashes if index >= videos.count

// ✅ FIX: Safe subscript
extension Collection {
    subscript(safe index: Index) -> Element? {
        indices.contains(index) ? self[index] : nil
    }
}

let video = videos[safe: index]
if let video = video {
    // Use video
}
```

#### SwiftUI State Issues
```swift
// ❌ PROBLEM: Modifying state during view update
struct VideoListView: View {
    @State private var videos: [Video] = []
    
    var body: some View {
        List(videos) { video in
            VideoRow(video: video)
                .onAppear {
                    videos.append(newVideo)  // Crash during view update!
                }
        }
    }
}

// ✅ FIX: Use Task or DispatchQueue
.onAppear {
    Task {
        videos.append(newVideo)
    }
}
```

#### Memory Leaks with NotificationCenter
```swift
// ❌ PROBLEM: Observer not removed
class VideoViewModel: ObservableObject {
    init() {
        NotificationCenter.default.addObserver(
            self,
            selector: #selector(videoDidFinish),
            name: .AVPlayerItemDidPlayToEndTime,
            object: nil
        )  // Leaks if not removed!
    }
}

// ✅ FIX: Remove observer
deinit {
    NotificationCenter.default.removeObserver(self)
}

// Or better: Use Combine
import Combine

var cancellables = Set<AnyCancellable>()

NotificationCenter.default.publisher(for: .AVPlayerItemDidPlayToEndTime)
    .sink { [weak self] _ in
        self?.handleVideoFinished()
    }
    .store(in: &cancellables)

deinit {
    cancellables.removeAll()  // Auto-cancels
}
```

#### Zombie Timer Issues
```swift
// ❌ PROBLEM: Timer retains target
class VideoViewModel: ObservableObject {
    var timer: Timer?
    
    func startTimer() {
        timer = Timer.scheduledTimer(
            timeInterval: 1.0,
            target: self,  // Strong reference!
            selector: #selector(tick),
            userInfo: nil,
            repeats: true
        )
    }
}

// ✅ FIX: Invalidate timer + use weak self
deinit {
    timer?.invalidate()
    timer = nil
}

// Or better: Use Combine
import Combine

var timerCancellable: AnyCancellable?

timerCancellable = Timer.publish(every: 1.0, on: .main, in: .common)
    .autoconnect()
    .sink { [weak self] _ in
        self?.tick()
    }

deinit {
    timerCancellable?.cancel()
}
```

