### Stripe Payment Intent
```swift
// ✅ CORRECT: Secure Stripe payment flow

import StripePaymentSheet

class PaymentManager: ObservableObject {
    @Published var paymentSheet: PaymentSheet?
    @Published var paymentResult: PaymentSheetResult?
    
    func createPaymentIntent(amount: Int, currency: String = "usd") async throws -> String {
        // Call your backend to create payment intent
        let url = URL(string: "\(AppConfig.API.baseURL)/create-payment-intent")!
        var request = URLRequest(url: url)
        request.httpMethod = "POST"
        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
        
        let body: [String: Any] = [
            "amount": amount,
            "currency": currency
        ]
        request.httpBody = try JSONSerialization.data(withJSONObject: body)
        
        let (data, _) = try await URLSession.shared.data(for: request)
        let json = try JSONSerialization.jsonObject(with: data) as! [String: Any]
        
        guard let clientSecret = json["clientSecret"] as? String else {
            throw PaymentError.invalidResponse
        }
        
        return clientSecret
    }
    
    func preparePaymentSheet(clientSecret: String, customerId: String?, ephemeralKey: String?) async {
        var configuration = PaymentSheet.Configuration()
        configuration.merchantDisplayName = "MyChannel"
        configuration.allowsDelayedPaymentMethods = true
        
        if let customerId = customerId, let ephemeralKey = ephemeralKey {
            configuration.customer = .init(id: customerId, ephemeralKeySecret: ephemeralKey)
        }
        
        await MainActor.run {
            paymentSheet = PaymentSheet(
                paymentIntentClientSecret: clientSecret,
                configuration: configuration
            )
        }
    }
    
    func presentPaymentSheet() async -> PaymentSheetResult {
        await withCheckedContinuation { continuation in
            paymentSheet?.present(from: getRootViewController()) { result in
                continuation.resume(returning: result)
            }
        }
    }
    
    private func getRootViewController() -> UIViewController {
        guard let scene = UIApplication.shared.connectedScenes.first as? UIWindowScene,
              let root = scene.windows.first?.rootViewController else {
            fatalError("No root view controller")
        }
        return root
    }
}

enum PaymentError: LocalizedError {
    case invalidResponse
    case paymentFailed
    case userCancelled
    
    var errorDescription: String? {
        switch self {
        case .invalidResponse: return "Invalid payment response"
        case .paymentFailed: return "Payment failed"
        case .userCancelled: return "Payment cancelled"
        }
    }
}
