## ⚡ ADVANCED CONCURRENCY & ACTORS

### Actor Isolation
```swift
// ✅ CORRECT: Actor patterns for thread safety

actor VideoCache {
    private var cache: [String: Video] = [:]
    private var accessCount: [String: Int] = [:]
    
    func store(_ video: Video) {
        cache[video.id] = video
        accessCount[video.id, default: 0] += 1
    }
    
    func retrieve(_ id: String) -> Video? {
        accessCount[id, default: 0] += 1
        return cache[id]
    }
    
    func mostAccessed(limit: Int = 10) -> [Video] {
        let sorted = accessCount.sorted { $0.value > $1.value }
        return sorted.prefix(limit).compactMap { cache[$0.key] }
    }
    
    func clear() {
        cache.removeAll()
        accessCount.removeAll()
    }
}

// Usage
let cache = VideoCache()

Task {
    await cache.store(video)
    let cached = await cache.retrieve(video.id)
    let popular = await cache.mostAccessed()
}
```

### Task Management
```swift
// ✅ CORRECT: Advanced task patterns

class VideoLoader {
    private var tasks: [String: Task<Video, Error>] = [:]
    
    // Cancellable tasks
    func loadVideo(id: String) async throws -> Video {
        // Cancel existing task if any
        tasks[id]?.cancel()
        
        // Create new task
        let task = Task<Video, Error> {
            try await fetchVideo(id: id)
        }
        
        tasks[id] = task
        
        // Wait for result
        let video = try await task.value
        
        // Clean up
        tasks.removeValue(forKey: id)
        
        return video
    }
    
    // Task groups for parallel loading
    func loadMultipleVideos(ids: [String]) async throws -> [Video] {
        try await withThrowingTaskGroup(of: Video.self) { group in
            for id in ids {
                group.addTask {
                    try await self.fetchVideo(id: id)
                }
            }
            
            var videos: [Video] = []
            for try await video in group {
                videos.append(video)
            }
            return videos
        }
    }
    
    // Task with timeout
    func loadVideoWithTimeout(id: String, timeout: TimeInterval) async throws -> Video {
        try await withThrowingTaskGroup(of: Video.self) { group in
            // Add fetch task
            group.addTask {
                try await self.fetchVideo(id: id)
            }
            
            // Add timeout task
            group.addTask {
                try await Task.sleep(nanoseconds: UInt64(timeout * 1_000_000_000))
                throw URLError(.timedOut)
            }
            
            // Return first result (race)
            let result = try await group.next()!
            group.cancelAll()
            return result
        }
    }
    
    func cancelAll() {
        tasks.values.forEach { $0.cancel() }
        tasks.removeAll()
    }
}
```

### AsyncSequence Patterns
```swift
// ✅ CORRECT: Custom async sequences

// 1. Live view count stream
struct LiveViewCountStream: AsyncSequence {
    typealias Element = Int
    
    let videoId: String
    let interval: TimeInterval
    
    struct AsyncIterator: AsyncIteratorProtocol {
        let videoId: String
        let interval: TimeInterval
        
        func next() async -> Int? {
            try? await Task.sleep(nanoseconds: UInt64(interval * 1_000_000_000))
            return await fetchViewCount(videoId: videoId)
        }
        
        private func fetchViewCount(videoId: String) async -> Int {
            // Fetch from API
            return Int.random(in: 1000...10000)
        }
    }
    
    func makeAsyncIterator() -> AsyncIterator {
        AsyncIterator(videoId: videoId, interval: interval)
    }
}

// Usage
let stream = LiveViewCountStream(videoId: "123", interval: 5)
for await viewCount in stream {
    print("Current views: \(viewCount)")
}

// 2. Chat message stream
actor ChatStream {
    private var continuation: AsyncStream<ChatMessage>.Continuation?
    
    func messages() -> AsyncStream<ChatMessage> {
        AsyncStream { continuation in
            self.continuation = continuation
            
            // Setup WebSocket listener
            setupWebSocket()
            
            continuation.onTermination = { @Sendable _ in
                // Cleanup
            }
        }
    }
    
    func sendMessage(_ message: ChatMessage) {
        continuation?.yield(message)
    }
    
    private func setupWebSocket() {
        // WebSocket setup
    }
}

// Usage
let chatStream = ChatStream()
Task {
    for await message in await chatStream.messages() {
        print("\(message.user.displayName): \(message.text)")
    }
}
```

