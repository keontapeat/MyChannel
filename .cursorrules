```swift
// ✅ CORRECT: Comprehensive crash tracking

import FirebaseCrashlytics

class CrashReporter {
    static let shared = CrashReporter()
    
    func setupCrashlytics() {
        #if !DEBUG
        // Enable Crashlytics
        Crashlytics.crashlytics().setCrashlyticsCollectionEnabled(true)
        
        // Set user info
        if let userId = getCurrentUserId() {
            Crashlytics.crashlytics().setUserID(userId)
        }
        
        // Set custom keys
        Crashlytics.crashlytics().setCustomValue(AppConfig.appVersion, forKey: "app_version")
        Crashlytics.crashlytics().setCustomValue(AppConfig.buildNumber, forKey: "build_number")
        #endif
    }
    
    func logError(_ error: Error, userInfo: [String: Any] = [:]) {
        #if !DEBUG
        Crashlytics.crashlytics().record(error: error, userInfo: userInfo)
        #endif
        
        print("🚨 [Crash] Error logged: \(error)")
    }
    
    func logNonFatal(_ message: String, userInfo: [String: Any] = [:]) {
        #if !DEBUG
        let error = NSError(
            domain: "com.mychannel.app",
            code: -1,
            userInfo: [NSLocalizedDescriptionKey: message] + userInfo
        )
        Crashlytics.crashlytics().record(error: error)
        #endif
    }
    
    func log(_ message: String) {
        #if !DEBUG
        Crashlytics.crashlytics().log(message)
        #endif
    }
    
    private func getCurrentUserId() -> String? {
        // Get from auth manager
        return nil
    }
}
