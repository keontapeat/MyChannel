## 🧪 TESTING STRATEGIES (TDD/BDD)

### Unit Testing Patterns
```swift
// ✅ CORRECT: Comprehensive unit tests

import XCTest
@testable import MyChannel

final class VideoServiceTests: XCTestCase {
    
    var sut: VideoFirestoreService!
    var mockFirestore: MockFirestore!
    
    override func setUp() {
        super.setUp()
        mockFirestore = MockFirestore()
        sut = VideoFirestoreService(firestore: mockFirestore)
    }
    
    override func tearDown() {
        sut = nil
        mockFirestore = nil
        super.tearDown()
    }
    
    // MARK: - Fetch Videos
    
    func testFetchVideos_Success() async throws {
        // Given
        let expectedVideos = Video.sampleVideos
        mockFirestore.videosToReturn = expectedVideos
        
        // When
        let videos = try await sut.fetchVideos(limit: 10)
        
        // Then
        XCTAssertEqual(videos.count, expectedVideos.count)
        XCTAssertEqual(videos.first?.id, expectedVideos.first?.id)
        XCTAssertEqual(mockFirestore.fetchCallCount, 1)
    }
    
    func testFetchVideos_NetworkError() async {
        // Given
        mockFirestore.errorToThrow = URLError(.notConnectedToInternet)
        
        // When/Then
        do {
            _ = try await sut.fetchVideos(limit: 10)
            XCTFail("Should throw error")
        } catch {
            XCTAssertTrue(error is URLError)
        }
    }
    
    func testFetchVideos_EmptyResult() async throws {
        // Given
        mockFirestore.videosToReturn = []
        
        // When
        let videos = try await sut.fetchVideos(limit: 10)
        
        // Then
        XCTAssertTrue(videos.isEmpty)
    }
    
    // MARK: - Performance Tests
    
    func testFetchVideosPerformance() {
        measure {
            let expectation = self.expectation(description: "Fetch videos")
            
            Task {
                _ = try? await sut.fetchVideos(limit: 100)
                expectation.fulfill()
            }
            
            wait(for: [expectation], timeout: 5.0)
        }
    }
    
    // MARK: - Async Tests
    
    func testLoadVideo_CompletesInReasonableTime() async {
        // Given
        let start = Date()
        
        // When
        _ = try? await sut.fetchVideos(limit: 10)
        
        // Then
        let duration = Date().timeIntervalSince(start)
        XCTAssertLessThan(duration, 2.0, "Fetch should complete in under 2 seconds")
    }
}

// MARK: - Mock Objects

class MockFirestore {
    var videosToReturn: [Video] = []
    var errorToThrow: Error?
    var fetchCallCount = 0
    
    func fetchDocuments() async throws -> [Video] {
        fetchCallCount += 1
        
        if let error = errorToThrow {
            throw error
        }
        
        return videosToReturn
    }
}
```

### UI Testing Patterns
```swift
// ✅ CORRECT: UI tests with Page Object pattern

import XCTest

final class VideoListUITests: XCTestCase {
    
    var app: XCUIApplication!
    var videoListPage: VideoListPage!
    
    override func setUp() {
        super.setUp()
        continueAfterFailure = false
        
        app = XCUIApplication()
        app.launchArguments = ["UI-Testing"]
        app.launch()
        
        videoListPage = VideoListPage(app: app)
    }
    
    func testVideoList_DisplaysVideos() {
        // Given
        videoListPage.waitForVideosToLoad()
        
        // Then
        XCTAssertTrue(videoListPage.isDisplayed)
        XCTAssertGreaterThan(videoListPage.videoCount, 0)
    }
    
    func testVideoTap_NavigatesToDetail() {
        // Given
        videoListPage.waitForVideosToLoad()
        
        // When
        videoListPage.tapVideo(at: 0)
        
        // Then
        let detailPage = VideoDetailPage(app: app)
        XCTAssertTrue(detailPage.isDisplayed)
    }
    
    func testSearch_FiltersResults() {
        // Given
        videoListPage.waitForVideosToLoad()
        let initialCount = videoListPage.videoCount
        
        // When
        videoListPage.search(query: "gaming")
        
        // Then
        XCTAssertLessThanOrEqual(videoListPage.videoCount, initialCount)
    }
}

// MARK: - Page Objects

struct VideoListPage {
    let app: XCUIApplication
    
    var isDisplayed: Bool {
        app.navigationBars["Home"].exists
    }
    
    var videoCount: Int {
        app.scrollViews.cells.count
    }
    
    func waitForVideosToLoad(timeout: TimeInterval = 5) {
        let firstVideo = app.scrollViews.cells.firstMatch
        _ = firstVideo.waitForExistence(timeout: timeout)
    }
    
    func tapVideo(at index: Int) {
        app.scrollViews.cells.element(boundBy: index).tap()
    }
    
    func search(query: String) {
        let searchField = app.searchFields.firstMatch
        searchField.tap()
        searchField.typeText(query)
    }
}

struct VideoDetailPage {
    let app: XCUIApplication
    
    var isDisplayed: Bool {
        app.staticTexts["Video Detail"].exists
    }
    
    func tapPlayButton() {
        app.buttons["Play"].tap()
    }
}
```

