// ✅ CORRECT: Update multiple settings atomically
func updateVideoSettings(
    videoId: String,
    commentsEnabled: Bool? = nil,
    likesEnabled: Bool? = nil,
    downloadsEnabled: Bool? = nil,
    ageRestricted: Bool? = nil,
    madeForKids: Bool? = nil
) async throws {
    guard let existingVideo = try await fetchVideo(videoId: videoId) else {
        throw VideoError.notFound
    }
    
    var updates: [String: Any] = [:]
    
    if let comments = commentsEnabled, comments != existingVideo.commentsEnabled {
        updates["commentsEnabled"] = comments
    }
    if let likes = likesEnabled, likes != existingVideo.likesEnabled {
        updates["likesEnabled"] = likes
    }
    if let downloads = downloadsEnabled, downloads != existingVideo.downloadsEnabled {
        updates["downloadsEnabled"] = downloads
    }
    if let ageRestricted = ageRestricted, ageRestricted != existingVideo.ageRestricted {
        updates["ageRestricted"] = ageRestricted
    }
    if let madeForKids = madeForKids, madeForKids != existingVideo.madeForKids {
        updates["madeForKids"] = madeForKids
    }
    
    guard !updates.isEmpty else { return }
    
    try await Firestore.firestore()
        .collection("videos")
        .document(videoId)
        .updateData(updates)
}
```

