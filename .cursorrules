### Subscription Management
```swift
// ✅ CORRECT: Subscription handling

class SubscriptionManager: ObservableObject {
    @Published var activeSubscription: Subscription?
    @Published var availablePlans: [SubscriptionPlan] = []
    
    func fetchAvailablePlans() async throws {
        // Fetch from backend
        let url = URL(string: "\(AppConfig.API.baseURL)/subscription-plans")!
        let (data, _) = try await URLSession.shared.data(from: url)
        availablePlans = try JSONDecoder().decode([SubscriptionPlan].self, from: data)
    }
    
    func subscribeToPlan(_ plan: SubscriptionPlan) async throws -> Subscription {
        // Create subscription via backend
        let url = URL(string: "\(AppConfig.API.baseURL)/subscriptions")!
        var request = URLRequest(url: url)
        request.httpMethod = "POST"
        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
        
        let body: [String: Any] = [
            "planId": plan.id,
            "userId": getCurrentUserId()
        ]
        request.httpBody = try JSONSerialization.data(withJSONObject: body)
        
        let (data, _) = try await URLSession.shared.data(for: request)
        let subscription = try JSONDecoder().decode(Subscription.self, from: data)
        
        activeSubscription = subscription
        return subscription
    }
    
    func cancelSubscription() async throws {
        guard let subscription = activeSubscription else { return }
        
        let url = URL(string: "\(AppConfig.API.baseURL)/subscriptions/\(subscription.id)/cancel")!
        var request = URLRequest(url: url)
        request.httpMethod = "POST"
        
        _ = try await URLSession.shared.data(for: request)
        activeSubscription = nil
    }
    
    func updatePaymentMethod(paymentMethodId: String) async throws {
        guard let subscription = activeSubscription else { return }
        
        let url = URL(string: "\(AppConfig.API.baseURL)/subscriptions/\(subscription.id)/payment-method")!
        var request = URLRequest(url: url)
        request.httpMethod = "PUT"
        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
        
        let body: [String: Any] = ["paymentMethodId": paymentMethodId]
        request.httpBody = try JSONSerialization.data(withJSONObject: body)
        
        _ = try await URLSession.shared.data(for: request)
    }
    
    private func getCurrentUserId() -> String {
        // Get from auth manager
        return "user-id"
    }
}

struct SubscriptionPlan: Codable, Identifiable {
    let id: String
    let name: String
    let price: Int // cents
    let interval: String // month, year
    let features: [String]
}

struct Subscription: Codable, Identifiable {
    let id: String
    let planId: String
    let status: String
    let currentPeriodEnd: Date
    let cancelAtPeriodEnd: Bool
}
