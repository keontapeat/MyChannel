### HLS Streaming
```swift
// ✅ CORRECT: HLS adaptive streaming setup

import AVFoundation

class HLSStreamManager {
    
    func createHLSPlaylist(from videoURL: URL, qualities: [VideoQuality]) async throws -> URL {
        let outputDir = FileManager.default.temporaryDirectory
            .appendingPathComponent(UUID().uuidString)
        
        try FileManager.default.createDirectory(at: outputDir, withIntermediateDirectories: true)
        
        // Create variant playlists for each quality
        var variants: [(quality: VideoQuality, url: URL)] = []
        
        for quality in qualities {
            let variantURL = try await createVariant(
                from: videoURL,
                quality: quality,
                outputDir: outputDir
            )
            variants.append((quality, variantURL))
        }
        
        // Create master playlist
        let masterPlaylistURL = outputDir.appendingPathComponent("master.m3u8")
        let masterPlaylist = createMasterPlaylist(variants: variants)
        try masterPlaylist.write(to: masterPlaylistURL, atomically: true, encoding: .utf8)
        
        return masterPlaylistURL
    }
    
    private func createVariant(
        from videoURL: URL,
        quality: VideoQuality,
        outputDir: URL
    ) async throws -> URL {
        let asset = AVAsset(url: videoURL)
        
        let qualityDir = outputDir.appendingPathComponent(quality.rawValue)
        try FileManager.default.createDirectory(at: qualityDir, withIntermediateDirectories: true)
        
        guard let exportSession = AVAssetExportSession(
            asset: asset,
            presetName: quality.exportPreset
        ) else {
            throw HLSError.exportFailed
        }
        
        let outputURL = qualityDir.appendingPathComponent("stream.m3u8")
        exportSession.outputURL = outputURL
        exportSession.outputFileType = .m3u8
        
        await exportSession.export()
        
        guard exportSession.status == .completed else {
            throw HLSError.exportFailed
        }
        
        return outputURL
    }
    
    private func createMasterPlaylist(variants: [(quality: VideoQuality, url: URL)]) -> String {
        var playlist = "#EXTM3U\n"
        playlist += "#EXT-X-VERSION:3\n\n"
        
        for variant in variants {
            let bandwidth = variant.quality.bandwidth
            let resolution = variant.quality.resolution
            
            playlist += "#EXT-X-STREAM-INF:BANDWIDTH=\(bandwidth),RESOLUTION=\(resolution)\n"
            playlist += "\(variant.quality.rawValue)/stream.m3u8\n\n"
        }
        
        return playlist
    }
}

extension VideoQuality {
    var bandwidth: Int {
        switch self {
        case .p240: return 400_000
        case .p360: return 800_000
        case .p480: return 1_400_000
        case .p720: return 2_800_000
        case .p1080: return 5_000_000
        case .p1440: return 8_000_000
        case .p4K: return 15_000_000
        }
    }
    
    var resolution: String {
        switch self {
        case .p240: return "426x240"
        case .p360: return "640x360"
        case .p480: return "854x480"
        case .p720: return "1280x720"
        case .p1080: return "1920x1080"
        case .p1440: return "2560x1440"
        case .p4K: return "3840x2160"
        }
    }
}

enum HLSError: LocalizedError {
    case exportFailed
    case variantCreationFailed
    
    var errorDescription: String? {
        switch self {
        case .exportFailed: return "HLS export failed"
        case .variantCreationFailed: return "Variant creation failed"
        }
    }
}
