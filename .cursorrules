## 📴 OFFLINE MODE & SYNC

### Offline Support
```swift
// ✅ CORRECT: Offline mode with sync

class OfflineManager {
    static let shared = OfflineManager()
    
    private let fileManager = FileManager.default
    private let cacheDirectory: URL
    
    init() {
        cacheDirectory = fileManager.urls(for: .cachesDirectory, in: .userDomainMask)[0]
            .appendingPathComponent("offline")
        
        try? fileManager.createDirectory(at: cacheDirectory, withIntermediateDirectories: true)
    }
    
    // Save for offline
    func saveForOffline(_ video: Video) async throws {
        // Download video file
        let videoURL = try await downloadVideo(video.videoURL)
        
        // Download thumbnail
        let thumbnailURL = try await downloadThumbnail(video.thumbnailURL)
        
        // Save metadata
        let metadata = OfflineVideoMetadata(
            video: video,
            videoLocalPath: videoURL.path,
            thumbnailLocalPath: thumbnailURL.path,
            downloadedAt: Date()
        )
        
        try saveMetadata(metadata)
    }
    
    // Get offline videos
    func getOfflineVideos() throws -> [OfflineVideoMetadata] {
        let metadataURL = cacheDirectory.appendingPathComponent("metadata.json")
        let data = try Data(contentsOf: metadataURL)
        return try JSONDecoder().decode([OfflineVideoMetadata].self, from: data)
    }
    
    // Remove offline video
    func removeOfflineVideo(_ videoId: String) throws {
        var videos = try getOfflineVideos()
        guard let index = videos.firstIndex(where: { $0.video.id == videoId }) else { return }
        
        let metadata = videos[index]
        
        // Delete files
        try? fileManager.removeItem(atPath: metadata.videoLocalPath)
        try? fileManager.removeItem(atPath: metadata.thumbnailLocalPath)
        
        // Update metadata
        videos.remove(at: index)
        try saveMetadata(videos)
    }
    
    private func downloadVideo(_ urlString: String) async throws -> URL {
        guard let url = URL(string: urlString) else {
            throw OfflineError.invalidURL
        }
        
        let (localURL, _) = try await URLSession.shared.download(from: url)
        let destination = cacheDirectory.appendingPathComponent(UUID().uuidString + ".mp4")
        try fileManager.moveItem(at: localURL, to: destination)
        
        return destination
    }
    
    private func downloadThumbnail(_ urlString: String) async throws -> URL {
        guard let url = URL(string: urlString) else {
            throw OfflineError.invalidURL
        }
        
        let (data, _) = try await URLSession.shared.data(from: url)
        let destination = cacheDirectory.appendingPathComponent(UUID().uuidString + ".jpg")
        try data.write(to: destination)
        
        return destination
    }
    
    private func saveMetadata(_ metadata: [OfflineVideoMetadata]) throws {
        let metadataURL = cacheDirectory.appendingPathComponent("metadata.json")
        let data = try JSONEncoder().encode(metadata)
        try data.write(to: metadataURL)
    }
    
    private func saveMetadata(_ metadata: OfflineVideoMetadata) throws {
        var videos = (try? getOfflineVideos()) ?? []
        videos.append(metadata)
        try saveMetadata(videos)
    }
}

struct OfflineVideoMetadata: Codable {
    let video: Video
    let videoLocalPath: String
    let thumbnailLocalPath: String
    let downloadedAt: Date
}

enum OfflineError: LocalizedError {
    case invalidURL
    case downloadFailed
}
```

