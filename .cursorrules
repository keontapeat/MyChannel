### Video Watch History & Resume Position

```swift
// ✅ CORRECT: Preserve watch history and resume positions
class VideoWatchHistoryService {
    // Save watch position (every 5 seconds during playback)
    func saveWatchPosition(videoId: String, position: TimeInterval) {
        let key = "watch_position_\(videoId)"
        UserDefaults.standard.set(position, forKey: key)
        
        // Also save to Firestore for cross-device sync
        Task {
            try? await Firestore.firestore()
                .collection("watchHistory")
                .document(videoId)
                .setData([
                    "position": position,
                    "lastWatched": FieldValue.serverTimestamp(),
                    "userId": getCurrentUserId()
                ], merge: true)
        }
    }
    
    // Load resume position
    func getResumePosition(videoId: String) -> TimeInterval? {
        let key = "watch_position_\(videoId)"
        let position = UserDefaults.standard.double(forKey: key)
        return position > 3 ? position : nil  // Only resume if > 3 seconds
    }
    
    // Clear watch position (only when video is watched to end or user explicitly clears)
    func clearWatchPosition(videoId: String) {
        let key = "watch_position_\(videoId)"
        UserDefaults.standard.removeObject(forKey: key)
    }
}

// ✅ CORRECT: Resume video from last position
func playVideo(_ video: Video) {
    // Setup player
    playerManager?.setupPlayer(with: video)
    
    // Resume from last position if available
    if let resumePosition = watchHistoryService.getResumePosition(videoId: video.id) {
        playerManager?.seek(to: resumePosition / video.duration)
    }
    
    // DO NOT auto-play - wait for user to press play
    // isPlaying = false  // User must press play button
}
```

