## 💉 DEPENDENCY INJECTION

### DI Container
```swift
// ✅ CORRECT: Dependency injection pattern

protocol DependencyContainer {
    func resolve<T>() -> T
}

class AppDependencyContainer: DependencyContainer {
    static let shared = AppDependencyContainer()
    
    private var factories: [String: Any] = [:]
    private var singletons: [String: Any] = [:]
    
    private init() {
        registerDependencies()
    }
    
    func register<T>(_ type: T.Type, factory: @escaping () -> T) {
        let key = String(describing: type)
        factories[key] = factory
    }
    
    func registerSingleton<T>(_ type: T.Type, instance: T) {
        let key = String(describing: type)
        singletons[key] = instance
    }
    
    func resolve<T>() -> T {
        let key = String(describing: T.self)
        
        // Check singletons first
        if let singleton = singletons[key] as? T {
            return singleton
        }
        
        // Check factories
        if let factory = factories[key] as? () -> T {
            return factory()
        }
        
        fatalError("No registration found for \(T.self)")
    }
    
    private func registerDependencies() {
        // Register services
        registerSingleton(NetworkService.self, instance: NetworkService.shared)
        registerSingleton(PersistenceController.self, instance: PersistenceController.shared)
        
        // Register repositories
        register(VideoRepository.self) {
            VideoRepository(networkService: self.resolve())
        }
        
        // Register view models
        register(VideoViewModel.self) {
            VideoViewModel(repository: self.resolve())
        }
    }
}

// Property wrapper for injection
@propertyWrapper
struct Injected<T> {
    private let container: DependencyContainer
    
    var wrappedValue: T {
        container.resolve()
    }
    
    init(container: DependencyContainer = AppDependencyContainer.shared) {
        self.container = container
    }
}

// Usage
class VideoViewModel: ObservableObject {
    @Injected private var repository: VideoRepository
    @Published var videos: [Video] = []
    
    func loadVideos() async {
        videos = try await repository.fetchVideos()
    }
}
```

