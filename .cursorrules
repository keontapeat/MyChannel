## 📊 ANALYTICS & METRICS

### Custom Analytics Engine
```swift
// ✅ CORRECT: Comprehensive analytics tracking

class AnalyticsEngine: ObservableObject {
    static let shared = AnalyticsEngine()
    
    private var events: [AnalyticsEvent] = []
    private var sessionId: String = UUID().uuidString
    private var sessionStart: Date = Date()
    
    private init() {
        setupSession()
    }
    
    // Track event
    func track(_ event: AnalyticsEvent) {
        events.append(event)
        
        // Send to backend
        Task {
            await sendEvent(event)
        }
        
        // Also send to Firebase/Mixpanel
        #if !DEBUG
        // Firebase Analytics
        // Mixpanel.track(event.name, properties: event.properties)
        #endif
    }
    
    // Screen view
    func trackScreen(_ name: String, properties: [String: Any] = [:]) {
        let event = AnalyticsEvent(
            name: "screen_view",
            category: .navigation,
            properties: ["screen_name": name].merging(properties) { $1 }
        )
        track(event)
    }
    
    // Video event
    func trackVideoEvent(
        _ action: VideoAction,
        videoId: String,
        position: TimeInterval? = nil
    ) {
        var properties: [String: Any] = [
            "video_id": videoId,
            "action": action.rawValue
        ]
        
        if let position = position {
            properties["position"] = position
        }
        
        let event = AnalyticsEvent(
            name: "video_\(action.rawValue)",
            category: .video,
            properties: properties
        )
        track(event)
    }
    
    // User event
    func trackUser Event(_ action: String, properties: [String: Any] = [:]) {
        let event = AnalyticsEvent(
            name: "user_\(action)",
            category: .user,
            properties: properties
        )
        track(event)
    }
    
    // Purchase event
    func trackPurchase(amount: Double, currency: String, itemId: String) {
        let event = AnalyticsEvent(
            name: "purchase",
            category: .revenue,
            properties: [
                "amount": amount,
                "currency": currency,
                "item_id": itemId,
                "revenue": amount
            ]
        )
        track(event)
    }
    
    // Session management
    private func setupSession() {
        // Track app launch
        track(AnalyticsEvent(
            name: "app_launch",
            category: .lifecycle,
            properties: [
                "session_id": sessionId,
                "app_version": AppConfig.appVersion,
                "build_number": AppConfig.buildNumber
            ]
        ))
        
        // Track session end on app termination
        NotificationCenter.default.addObserver(
            forName: UIApplication.willTerminateNotification,
            object: nil,
            queue: .main
        ) { [weak self] _ in
            self?.endSession()
        }
    }
    
    private func endSession() {
        let duration = Date().timeIntervalSince(sessionStart)
        
        track(AnalyticsEvent(
            name: "session_end",
            category: .lifecycle,
            properties: [
                "session_id": sessionId,
                "duration": duration,
                "events_count": events.count
            ]
        ))
        
        // Flush remaining events
        Task {
            await flush()
        }
    }
    
    // Send to backend
    private func sendEvent(_ event: AnalyticsEvent) async {
        guard let url = URL(string: "\(AppConfig.API.baseURL)/analytics/events") else { return }
        
        var request = URLRequest(url: url)
        request.httpMethod = "POST"
        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
        
        do {
            let data = try JSONEncoder().encode(event)
            request.httpBody = data
            _ = try await URLSession.shared.data(for: request)
        } catch {
            print("🚨 [Analytics] Failed to send event: \(error)")
        }
    }
    
    // Flush all events
    func flush() async {
        for event in events {
            await sendEvent(event)
        }
        events.removeAll()
    }
}

struct AnalyticsEvent: Codable {
    let id: String = UUID().uuidString
    let name: String
    let category: EventCategory
    let properties: [String: AnyCodable]
    let timestamp: Date = Date()
    
    init(name: String, category: EventCategory, properties: [String: Any]) {
        self.name = name
        self.category = category
        self.properties = properties.mapValues { AnyCodable($0) }
    }
}

enum EventCategory: String, Codable {
    case navigation
    case video
    case user
    case revenue
    case lifecycle
    case engagement
}

enum VideoAction: String {
    case play, pause, seek, complete, error
}
