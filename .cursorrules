### Fraud Prevention
```swift
// ✅ CORRECT: Payment fraud detection

class FraudDetectionService {
    
    func analyzePayment(
        amount: Int,
        userId: String,
        ipAddress: String,
        deviceId: String
    ) async -> FraudRiskScore {
        var riskScore: Double = 0.0
        var reasons: [String] = []
        
        // 1. Check unusual amount
        let avgAmount = await getAveragePaymentAmount(userId: userId)
        if Double(amount) > avgAmount * 5 {
            riskScore += 0.3
            reasons.append("Unusually high amount")
        }
        
        // 2. Check payment frequency
        let recentPayments = await getRecentPayments(userId: userId, hours: 1)
        if recentPayments.count > 5 {
            riskScore += 0.4
            reasons.append("Too many payments in short time")
        }
        
        // 3. Check IP location
        let expectedCountry = await getUserCountry(userId: userId)
        let ipCountry = await getCountryFromIP(ipAddress)
        if expectedCountry != ipCountry {
            riskScore += 0.2
            reasons.append("Payment from unexpected location")
        }
        
        // 4. Check device fingerprint
        let knownDevices = await getKnownDevices(userId: userId)
        if !knownDevices.contains(deviceId) {
            riskScore += 0.1
            reasons.append("New device")
        }
        
        return FraudRiskScore(
            score: min(riskScore, 1.0),
            level: getFraudLevel(score: riskScore),
            reasons: reasons
        )
    }
    
    private func getFraudLevel(score: Double) -> FraudLevel {
        switch score {
        case 0..<0.3: return .low
        case 0.3..<0.6: return .medium
        case 0.6...1.0: return .high
        default: return .low
        }
    }
    
    // Helper methods (implement with real data)
    private func getAveragePaymentAmount(userId: String) async -> Double { 50.0 }
    private func getRecentPayments(userId: String, hours: Int) async -> [Payment] { [] }
    private func getUserCountry(userId: String) async -> String { "US" }
    private func getCountryFromIP(_ ip: String) async -> String { "US" }
    private func getKnownDevices(userId: String) async -> [String] { [] }
}

struct FraudRiskScore {
    let score: Double
    let level: FraudLevel
    let reasons: [String]
}

enum FraudLevel {
    case low, medium, high
    
    var shouldBlock: Bool {
        self == .high
    }
}

struct Payment: Codable {
    let id: String
    let amount: Int
    let timestamp: Date
}
