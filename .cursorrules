### 🌐 NETWORK DEBUGGING

#### Charles Proxy / Proxyman
```
Setup:
1. Install Charles Proxy or Proxyman
2. Configure iOS device proxy:
   Settings → Wi-Fi → (i) → HTTP Proxy → Manual
   Server: Your Mac's IP
   Port: 8888
3. Install SSL certificate on device

Features:
- See all HTTP/HTTPS requests
- Inspect request/response headers
- View JSON/XML bodies
- Throttle network speed
- Mock responses
- Breakpoint requests
- Repeat requests
- Export HAR files

Common uses:
- Debug API calls
- Test slow network
- Mock server responses
- Inspect OAuth flows
- Debug WebSocket
```

#### URLSession Debugging
```swift
// ✅ CORRECT: Detailed network debugging

class NetworkDebugger {
    static func logRequest(_ request: URLRequest) {
        print("🌐 [Network] Request")
        print("  URL: \(request.url?.absoluteString ?? "nil")")
        print("  Method: \(request.httpMethod ?? "nil")")
        print("  Headers: \(request.allHTTPHeaderFields ?? [:])")
        if let body = request.httpBody {
            print("  Body: \(String(data: body, encoding: .utf8) ?? "binary")")
        }
    }
    
    static func logResponse(_ response: URLResponse?, data: Data?, error: Error?) {
        print("🌐 [Network] Response")
        
        if let httpResponse = response as? HTTPURLResponse {
            print("  Status: \(httpResponse.statusCode)")
            print("  Headers: \(httpResponse.allHeaderFields)")
        }
        
        if let data = data {
            print("  Size: \(data.count) bytes")
            if let json = try? JSONSerialization.jsonObject(with: data),
               let prettyData = try? JSONSerialization.data(withJSONObject: json, options: .prettyPrinted),
               let prettyString = String(data: prettyData, encoding: .utf8) {
                print("  JSON:\n\(prettyString)")
            } else {
                print("  Body: \(String(data: data, encoding: .utf8) ?? "binary")")
            }
        }
        
        if let error = error {
            print("  Error: \(error)")
        }
    }
}

// Usage
extension URLSession {
    func debugDataTask(with request: URLRequest) async throws -> (Data, URLResponse) {
        NetworkDebugger.logRequest(request)
        
        let (data, response) = try await data(for: request)
        
        NetworkDebugger.logResponse(response, data: data, error: nil)
        
        return (data, response)
    }
}
```

