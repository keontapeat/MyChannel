### Video Deletion Rules (Expanded)

```swift
// ✅ CORRECT: Comprehensive deletion with user confirmation
func deleteVideo(videoId: String) async throws {
    // 1. Show confirmation dialog
    // 2. Only delete after user confirms
    
    // 3. Delete from Firestore
    try await Firestore.firestore()
        .collection("videos")
        .document(videoId)
        .delete()
    
    // 4. Delete video file from storage
    guard let video = try? await fetchVideo(videoId: videoId) else { return }
    
    if !video.videoURL.isEmpty {
        try await Storage.storage()
            .reference(forURL: video.videoURL)
            .delete()
    }
    
    // 5. Delete thumbnail
    if !video.thumbnailURL.isEmpty {
        try await Storage.storage()
            .reference(forURL: video.thumbnailURL)
            .delete()
    }
    
    // 6. Delete all quality variants
    if let variants = video.qualityVariants {
        for variant in variants {
            try? await Storage.storage()
                .reference(forURL: variant.url)
                .delete()
        }
    }
    
    // 7. Delete subtitles
    if let subtitles = video.subtitles {
        for subtitle in subtitles {
            try? await Storage.storage()
                .reference(forURL: subtitle.url)
                .delete()
        }
    }
    
    // 8. Remove from all playlists (but don't delete playlists)
    if let playlistIds = video.playlistIds {
        for playlistId in playlistIds {
            try? await removeVideoFromPlaylist(videoId: videoId, playlistId: playlistId)
        }
    }
    
    // 9. Delete watch history (optional - may want to keep for analytics)
    // try? await deleteWatchHistory(videoId: videoId)
    
    // 10. Decrement user's video count
    try? await decrementUserVideoCount(userId: video.creatorId)
}

// ❌ WRONG: Soft delete or hiding videos
func deleteVideo(videoId: String) async throws {
    // Don't just set isDeleted = true
    // User expects actual deletion when they confirm
    try await updateVideo(videoId, isDeleted: true)  // WRONG!
}
```

### Video Upload Complete Checklist

```swift
// ✅ CORRECT: Complete upload process that preserves everything
func completeVideoUpload(video: Video, metadata: VideoMetadata) async throws {
    // 1. Upload video file (permanent URL)
    let videoURL = try await uploadVideoFile(video.fileData)
    
    // 2. Generate and upload thumbnail (permanent URL)
    let thumbnailURL = try await generateAndUploadThumbnail(video: video)
    
    // 3. Create video document with ALL metadata
    let savedVideo = Video(
        id: UUID().uuidString,
        title: metadata.title,  // User-provided title
        description: metadata.description,  // User-provided description
        videoURL: videoURL,  // Permanent URL - NEVER change
        thumbnailURL: thumbnailURL,  // Permanent URL - NEVER change
        duration: video.duration,  // From video file - NEVER change
        category: metadata.category,  // User-selected category
        tags: metadata.tags,  // User-provided tags
        isPublic: metadata.isPublic,  // User-selected privacy
        creator: getCurrentUser(),  // Snapshot of creator at upload time
        createdAt: Date(),  // Upload timestamp - NEVER change
        // ... all other fields
    )
    
    // 4. Save to Firestore (this is the source of truth)
    try await VideoFirestoreService.shared.saveVideo(savedVideo)
    
    // 5. Increment user's video count
    try await incrementUserVideoCount(userId: savedVideo.creatorId)
    
    // 6. Trigger video processing (transcoding, quality variants)
    // This happens in background and doesn't modify the original upload
    Task {
        try? await TranscodingService.shared.processVideo(savedVideo)
    }
    
    // 7. Return saved video (user can now edit metadata if needed)
    return savedVideo
}
```

### Video Update Best Practices Summary

1. **ALWAYS** fetch existing video before updating
2. **ONLY** update fields that actually changed
3. **NEVER** overwrite entire video object
4. **USE** Firestore `updateData()` with specific fields, not `setData()`
5. **USE** `FieldValue.increment()` for metrics (atomic operations)
6. **USE** `FieldValue.arrayUnion()` / `arrayRemove()` for arrays
7. **PRESERVE** all user-created content (chapters, cards, end screens)
8. **PRESERVE** all uploaded files (video, thumbnails, subtitles)
9. **PRESERVE** all timestamps (createdAt, updatedAt)
10. **REQUIRE** explicit user action for destructive operations
11. **NEVER** auto-play videos
12. **NEVER** restart videos automatically
13. **PRESERVE** playback position across sessions
14. **PRESERVE** watch history
15. **PRESERVE** all engagement metrics

---

