### 📝 LOGGING BEST PRACTICES

#### Structured Logging
```swift
import os.log

// ✅ CORRECT: Unified Logging System

// Define log categories
extension OSLog {
    private static var subsystem = Bundle.main.bundleIdentifier!
    
    static let ui = OSLog(subsystem: subsystem, category: "UI")
    static let network = OSLog(subsystem: subsystem, category: "Network")
    static let database = OSLog(subsystem: subsystem, category: "Database")
    static let agi = OSLog(subsystem: subsystem, category: "AGI")
}

// Usage with log levels
class VideoService {
    func fetchVideos() async throws -> [Video] {
        os_log(.debug, log: .network, "Fetching videos...")
        
        do {
            let videos = try await api.fetch()
            os_log(.info, log: .network, "Fetched %d videos", videos.count)
            return videos
        } catch {
            os_log(.error, log: .network, "Failed to fetch videos: %{public}@", error.localizedDescription)
            throw error
        }
    }
}

// Log levels:
// .debug    - Detailed troubleshooting (stripped in release)
// .info     - General informational
// .default  - Default level
// .error    - Error conditions
// .fault    - Critical failures

// View logs:
// Console.app → Filter by subsystem
// Xcode Console → Filter
```

