### 🎯 DEBUG MENU (PRODUCTION-READY)

```swift
// ✅ CORRECT: Shake to open debug menu (only in TestFlight/Debug)

#if DEBUG || TESTFLIGHT
class DebugMenuManager {
    static let shared = DebugMenuManager()
    
    func show() {
        let menu = UIAlertController(
            title: "🐛 Debug Menu",
            message: "MyChannel v\(AppConfig.appVersion) (\(AppConfig.buildNumber))",
            preferredStyle: .actionSheet
        )
        
        // Environment
        menu.addAction(UIAlertAction(title: "Environment: \(AppConfig.environment)", style: .default))
        
        // Clear cache
        menu.addAction(UIAlertAction(title: "Clear Image Cache", style: .destructive) { _ in
            ImageCache.shared.clearCache()
        })
        
        // Reset onboarding
        menu.addAction(UIAlertAction(title: "Reset Onboarding", style: .default) { _ in
            UserDefaults.standard.set(false, forKey: "hasCompletedOnboarding")
        })
        
        // Force crash (test crash reporting)
        menu.addAction(UIAlertAction(title: "💥 Force Crash", style: .destructive) { _ in
            fatalError("Test crash from debug menu")
        })
        
        // Memory stats
        let memoryUsage = ProcessInfo.processInfo.physicalMemory
        menu.addAction(UIAlertAction(title: "Memory: \(memoryUsage.formatted(.byteCount(style: .memory)))", style: .default))
        
        // Network stats
        menu.addAction(UIAlertAction(title: "Network: \(NetworkMonitor.shared.status)", style: .default))
        
        // AGI Agent Dashboard
        menu.addAction(UIAlertAction(title: "🤖 AGI Agent Dashboard", style: .default) { _ in
            // Navigate to AGI dashboard
        })
        
        // Export logs
        menu.addAction(UIAlertAction(title: "📋 Export Logs", style: .default) { _ in
            DebugLogger.shared.exportLogs()
        })
        
        menu.addAction(UIAlertAction(title: "Cancel", style: .cancel))
        
        // Present
        if let scene = UIApplication.shared.connectedScenes.first as? UIWindowScene,
           let rootVC = scene.windows.first?.rootViewController {
            rootVC.present(menu, animated: true)
        }
    }
}

// SwiftUI: Detect shake gesture
extension UIWindow {
    open override func motionEnded(_ motion: UIEvent.EventSubtype, with event: UIEvent?) {
        if motion == .motionShake {
            DebugMenuManager.shared.show()
        }
    }
}
#endif
```

