// ✅ CORRECT: Ensure player is ready before showing mini-player
func playVideo(_ video: Video, showFullscreen: Bool = true) {
    // Setup player first
    playerManager?.setupPlayer(with: video)
    
    // Wait for player to be ready
    DispatchQueue.main.asyncAfter(deadline: .now() + 0.1) {
        // Only show mini-player if player is ready
        if playerManager?.player?.status == .readyToPlay {
            shouldShowMiniPlayer = !showFullscreen
        }
    }
}
