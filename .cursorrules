### Video Playlist Associations

```swift
// ✅ CORRECT: Preserve playlist associations
func addVideoToPlaylist(videoId: String, playlistId: String) async throws {
    // Add to playlist's video array
    try await Firestore.firestore()
        .collection("playlists")
        .document(playlistId)
        .updateData([
            "videoIds": FieldValue.arrayUnion([videoId])
        ])
    
    // Add playlist to video's playlist array
    try await Firestore.firestore()
        .collection("videos")
        .document(videoId)
        .updateData([
            "playlistIds": FieldValue.arrayUnion([playlistId])
        ])
}

// ✅ CORRECT: Remove from playlist (preserve video)
func removeVideoFromPlaylist(videoId: String, playlistId: String) async throws {
    // Remove from playlist
    try await Firestore.firestore()
        .collection("playlists")
        .document(playlistId)
        .updateData([
            "videoIds": FieldValue.arrayRemove([videoId])
        ])
    
    // Remove playlist from video
    try await Firestore.firestore()
        .collection("videos")
        .document(videoId)
        .updateData([
            "playlistIds": FieldValue.arrayRemove([playlistId])
        ])
    
    // Video itself is NOT deleted - only association removed
}
```

