// ✅ CORRECT: Universal links and deep linking

class DeepLinkManager: ObservableObject {
    static let shared = DeepLinkManager()
    
    @Published var currentDeepLink: DeepLink?
    
    // Handle URL
    func handleURL(_ url: URL) {
        guard let deepLink = parseURL(url) else {
            print("⚠️ [DeepLink] Invalid URL: \(url)")
            return
        }
        
        currentDeepLink = deepLink
        navigate(to: deepLink)
    }
    
    // Parse URL to DeepLink
    private func parseURL(_ url: URL) -> DeepLink? {
        // mychannel://video/123
        // https://mychannel.live/video/123
        
        guard let host = url.host else { return nil }
        let pathComponents = url.pathComponents.filter { $0 != "/" }
        
        switch host {
        case "video", "mychannel.live" where pathComponents.first == "video":
            guard let videoId = pathComponents.last else { return nil }
            return .video(id: videoId)
            
        case "profile":
            guard let username = pathComponents.last else { return nil }
            return .profile(username: username)
            
        case "flicks":
            guard let flickId = pathComponents.last else { return nil }
            return .flick(id: flickId)
            
        case "live":
            guard let streamId = pathComponents.last else { return nil }
            return .liveStream(id: streamId)
            
        case "match":
            guard let matchId = pathComponents.last else { return nil }
            return .vsMatch(id: matchId)
            
        default:
            return nil
        }
    }
    
    // Navigate to deep link
    private func navigate(to deepLink: DeepLink) {
        print("🔗 [DeepLink] Navigating to: \(deepLink)")
        
        // Implement navigation logic
        // Use NavigationStack or custom navigation
    }
}

enum DeepLink {
    case video(id: String)
    case profile(username: String)
    case flick(id: String)
    case liveStream(id: String)
    case vsMatch(id: String)
    case award(categoryId: String)
}
