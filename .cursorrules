## 🎥 COMPREHENSIVE VIDEO PRESERVATION RULES

### Video Metadata Preservation

```swift
// ✅ CORRECT: Preserve ALL video metadata fields
struct VideoMetadata {
    // Core fields (NEVER modify without user action)
    let id: String  // NEVER change
    let videoURL: String  // NEVER change unless user re-uploads
    let thumbnailURL: String  // NEVER change unless user replaces thumbnail
    var title: String  // Only change if user edits
    var description: String  // Only change if user edits
    var category: VideoCategory  // Only change if user edits
    var tags: [String]  // Only change if user edits
    
    // Engagement metrics (NEVER reset or modify)
    var viewCount: Int  // Only increment, never decrement
    var likeCount: Int  // Only change via user interactions
    var dislikeCount: Int  // Only change via user interactions
    var commentCount: Int  // Only change via actual comments
    var shareCount: Int  // Only increment on actual shares
    
    // Timestamps (NEVER modify)
    let createdAt: Date  // NEVER change
    var updatedAt: Date  // Only update when metadata changes
    
    // Creator info (NEVER modify)
    let creatorId: String  // NEVER change
    let creator: User  // NEVER change (snapshot at upload time)
    
    // Video properties (NEVER modify unless user re-uploads)
    let duration: TimeInterval  // NEVER change
    let aspectRatio: AspectRatio  // NEVER change
    let quality: [VideoQuality]  // NEVER change (video file properties)
    let fileSize: Int64  // NEVER change
    
    // Content settings (only change if user explicitly changes)
    var isPublic: Bool
    var ageRestricted: Bool
    var madeForKids: Bool
    var commentsEnabled: Bool
    var likesEnabled: Bool
    var downloadsEnabled: Bool
    
    // Advanced features (preserve user settings)
    var chapters: [Video.Chapter]?  // Preserve if user added chapters
    var videoCards: [VideoCard]?  // Preserve user-created cards
    var endScreens: [EndScreen]?  // Preserve user-created end screens
    var subtitles: [SubtitleTrack]?  // Preserve user-uploaded subtitles
    var transcript: VideoTranscript?  // Preserve auto-generated transcript
    
    // Monetization (preserve user settings)
    var monetization: MonetizationSettings?  // NEVER modify without user action
    var isSponsored: Bool  // Only change if user edits
    
    // Scheduling (preserve user settings)
    var scheduledAt: Date?  // Preserve scheduled publish time
    var isPremiere: Bool  // Preserve premiere settings
    
    // Playlist associations (preserve user selections)
    var playlistIds: [String]  // Only change if user adds/removes from playlists
    
    // Analytics (read-only, never modify)
    var watchTime: TimeInterval  // Only increment
    var averageWatchPercentage: Double  // Only update via analytics
    var retentionData: [Double]  // Only update via analytics
}
```

### Thumbnail Preservation Rules

```swift
// ✅ CORRECT: Preserve thumbnails unless user explicitly replaces
func updateVideoThumbnail(videoId: String, newThumbnail: UIImage) async throws {
    // 1. Fetch existing video
    guard let existingVideo = try await fetchVideo(videoId: videoId) else {
        throw VideoError.notFound
    }
    
    // 2. Upload new thumbnail (don't delete old one immediately)
    let newThumbnailURL = try await uploadThumbnail(newThumbnail)
    
    // 3. Update video with new thumbnail URL
    try await updateVideoMetadata(
        videoId: videoId,
        thumbnailURL: newThumbnailURL
    )
    
    // 4. Delete old thumbnail AFTER successful update (optional cleanup)
    // Only if you want to save storage - but be careful!
    // try? await deleteThumbnail(existingVideo.thumbnailURL)
}

// ❌ WRONG: Replacing thumbnail without preserving old one
func updateThumbnail(videoId: String, thumbnail: UIImage) async throws {
    // This loses the original thumbnail!
    let url = try await uploadThumbnail(thumbnail)
    try await updateVideo(videoId, thumbnailURL: url)  // Old thumbnail lost!
}
