## 🔄 COMBINE FRAMEWORK PATTERNS

### Advanced Combine Usage
```swift
// ✅ CORRECT: Combine reactive patterns

import Combine

class SearchViewModel: ObservableObject {
    @Published var searchText: String = ""
    @Published var results: [Video] = []
    @Published var isLoading = false
    
    private var cancellables = Set<AnyCancellable>()
    private let searchService: SearchService
    
    init(searchService: SearchService = SearchService.shared) {
        self.searchService = searchService
        setupSearch()
    }
    
    private func setupSearch() {
        // Debounce search
        $searchText
            .debounce(for: .milliseconds(300), scheduler: DispatchQueue.main)
            .removeDuplicates()
            .filter { !$0.isEmpty }
            .map { [weak self] query -> AnyPublisher<[Video], Never> in
                guard let self = self else {
                    return Just([]).eraseToAnyPublisher()
                }
                
                self.isLoading = true
                
                return Future { promise in
                    Task {
                        do {
                            let results = try await self.searchService.search(query: query)
                            promise(.success(results))
                        } catch {
                            promise(.success([]))
                        }
                    }
                }
                .receive(on: DispatchQueue.main)
                .eraseToAnyPublisher()
            }
            .switchToLatest()
            .sink { [weak self] videos in
                self?.results = videos
                self?.isLoading = false
            }
            .store(in: &cancellables)
    }
}

// Combine operators for network requests
extension NetworkService {
    func executePublisher<T: NetworkRequest>(_ request: T) -> AnyPublisher<T.Response, Error> {
        Future { promise in
            Task {
                do {
                    let response = try await self.execute(request)
                    promise(.success(response))
                } catch {
                    promise(.failure(error))
                }
            }
        }
        .eraseToAnyPublisher()
    }
}

// Combine multiple requests
class VideoDetailViewModel: ObservableObject {
    @Published var video: Video?
    @Published var relatedVideos: [Video] = []
    @Published var comments: [Comment] = []
    @Published var isLoading = false
    
    private var cancellables = Set<AnyCancellable>()
    
    func loadVideo(id: String) {
        isLoading = true
        
        let videoPublisher = NetworkService.shared.executePublisher(FetchVideoRequest(id: id))
        let relatedPublisher = NetworkService.shared.executePublisher(FetchRelatedVideosRequest(id: id))
        let commentsPublisher = NetworkService.shared.executePublisher(FetchCommentsRequest(videoId: id))
        
        Publishers.Zip3(videoPublisher, relatedPublisher, commentsPublisher)
            .receive(on: DispatchQueue.main)
            .sink(
                receiveCompletion: { [weak self] completion in
                    self?.isLoading = false
                    if case .failure(let error) = completion {
                        print("🚨 Error: \(error)")
                    }
                },
                receiveValue: { [weak self] video, related, comments in
                    self?.video = video
                    self?.relatedVideos = related
                    self?.comments = comments
                }
            )
            .store(in: &cancellables)
    }
}
```

