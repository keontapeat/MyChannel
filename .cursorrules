### Cohort Analysis
```swift
// ✅ CORRECT: User cohort tracking

class CohortAnalyzer {
    
    func createCohort(name: String, startDate: Date, endDate: Date, criteria: CohortCriteria) async -> Cohort {
        let users = await getUsersMatchingCriteria(criteria, startDate: startDate, endDate: endDate)
        
        let cohort = Cohort(
            id: UUID().uuidString,
            name: name,
            creationDate: startDate,
            userIds: users.map { $0.id },
            totalUsers: users.count
        )
        
        await saveCohort(cohort)
        return cohort
    }
    
    func trackCohortRetention(cohortId: String, days: [Int]) async -> [Int: Double] {
        guard let cohort = await getCohort(cohortId) else { return [:] }
        
        var retention: [Int: Double] = [:]
        
        for day in days {
            let activeUsers = await getActiveUsers(
                cohortId: cohortId,
                daysAfterCreation: day
            )
            let retentionRate = Double(activeUsers.count) / Double(cohort.totalUsers)
            retention[day] = retentionRate
        }
        
        return retention
    }
    
    private func getUsersMatchingCriteria(_ criteria: CohortCriteria, startDate: Date, endDate: Date) async -> [User] { [] }
    private func saveCohort(_ cohort: Cohort) async { }
    private func getCohort(_ id: String) async -> Cohort? { nil }
    private func getActiveUsers(cohortId: String, daysAfterCreation: Int) async -> [User] { [] }
}

struct Cohort {
    let id: String
    let name: String
    let creationDate: Date
    let userIds: [String]
    let totalUsers: Int
}

enum CohortCriteria {
    case registrationDate(Date)
    case firstPurchaseDate(Date)
    case platform(String)
    case country(String)
}
