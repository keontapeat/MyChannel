## 🚀 CI/CD & AUTOMATION

### Fastlane Setup
```ruby
# ✅ CORRECT: Fastlane configuration

# Fastfile
default_platform(:ios)

platform :ios do
  
  # Build & Test
  desc "Run tests"
  lane :test do
    run_tests(
      scheme: "MyChannel",
      devices: ["iPhone 15 Pro", "iPad Pro (12.9-inch)"],
      clean: true
    )
  end
  
  # Beta Distribution
  desc "Deploy to TestFlight"
  lane :beta do
    # Increment build number
    increment_build_number(xcodeproj: "MyChannel.xcodeproj")
    
    # Build app
    build_app(
      scheme: "MyChannel",
      export_method: "app-store",
      clean: true
    )
    
    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      notify_external_testers: false
    )
    
    # Send notification
    slack(
      message: "New TestFlight build uploaded! 🚀",
      channel: "#releases"
    )
  end
  
  # Production Release
  desc "Deploy to App Store"
  lane :release do
    # Ensure clean git
    ensure_git_status_clean
    
    # Increment version
    increment_version_number(
      bump_type: "patch"
    )
    
    # Build & upload
    build_app(scheme: "MyChannel")
    upload_to_app_store(
      submit_for_review: true,
      automatic_release: false,
      skip_metadata: false,
      skip_screenshots: false
    )
    
    # Tag release
    add_git_tag(
      tag: "v#{get_version_number}"
    )
    push_git_tags
    
    # Notify team
    slack(
      message: "App Store release submitted for review! 🎉",
      channel: "#releases"
    )
  end
  
  # Screenshots
  desc "Generate screenshots"
  lane :screenshots do
    snapshot(
      scheme: "MyChannelUITests",
      devices: [
        "iPhone 15 Pro Max",
        "iPhone 15 Pro",
        "iPhone SE (3rd generation)",
        "iPad Pro (12.9-inch)"
      ],
      languages: ["en-US", "es-ES", "ja-JP"]
    )
  end
  
  # Code Quality
  desc "Run SwiftLint"
  lane :lint do
    swiftlint(
      mode: :lint,
      config_file: ".swiftlint.yml",
      raise_if_swiftlint_error: true
    )
  end
  
  # Error handling
  error do |lane, exception|
    slack(
      message: "Build failed in lane #{lane}: #{exception}",
      success: false,
      channel: "#build-failures"
    )
  end
end
```

### GitHub Actions
```yaml
# ✅ CORRECT: GitHub Actions workflow

name: iOS CI/CD

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main ]

jobs:
  test:
    name: Run Tests
    runs-on: macos-14
    
    steps:
    - uses: actions/checkout@v4
    
    - name: Select Xcode
      run: sudo xcode-select -s /Applications/Xcode_15.2.app
    
    - name: Cache SPM
      uses: actions/cache@v3
      with:
        path: .build
        key: ${{ runner.os }}-spm-${{ hashFiles('**/Package.resolved') }}
        restore-keys: |
          ${{ runner.os }}-spm-
    
    - name: Install Dependencies
      run: |
        gem install bundler
        bundle install
    
    - name: Run SwiftLint
      run: bundle exec fastlane lint
    
    - name: Run Tests
      run: bundle exec fastlane test
    
    - name: Upload Coverage
      uses: codecov/codecov-action@v3
      with:
        files: ./coverage/coverage.xml
        fail_ci_if_error: true
  
  beta:
    name: Deploy to TestFlight
    runs-on: macos-14
    needs: test
    if: github.ref == 'refs/heads/main'
    
    steps:
    - uses: actions/checkout@v4
    
    - name: Setup Fastlane
      run: |
        gem install bundler
        bundle install
    
    - name: Setup App Store Connect API Key
      env:
        APP_STORE_CONNECT_API_KEY: ${{ secrets.APP_STORE_CONNECT_API_KEY }}
      run: echo "$APP_STORE_CONNECT_API_KEY" > ~/private_keys/AuthKey.p8
    
    - name: Deploy to TestFlight
      env:
        MATCH_PASSWORD: ${{ secrets.MATCH_PASSWORD }}
      run: bundle exec fastlane beta
    
    - name: Notify Slack
      if: always()
      uses: 8398a7/action-slack@v3
      with:
        status: ${{ job.status }}
        text: TestFlight deployment ${{ job.status }}
        webhook_url: ${{ secrets.SLACK_WEBHOOK }}
  
  release:
    name: App Store Release
    runs-on: macos-14
    needs: test
    if: startsWith(github.ref, 'refs/tags/v')
    
    steps:
    - uses: actions/checkout@v4
    
    - name: Setup Fastlane
      run: |
        gem install bundler
        bundle install
    
    - name: Deploy to App Store
      env:
        MATCH_PASSWORD: ${{ secrets.MATCH_PASSWORD }}
      run: bundle exec fastlane release
