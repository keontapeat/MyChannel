{
  "displayName": "Doctor 5xx errors",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "5xx > 0 for 3m",
      "conditionThreshold": {
        "filter": "resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"doctor\" AND metric.type=\"run.googleapis.com/request_count\" AND metric.label.\"response_code_class\"=\"5xx\"",
        "aggregations": [
          { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["resource.label.\"service_name\""] }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "180s",
        "trigger": { "count": 1 }
      }
    }
  ],
  "notificationChannels": [""]
}
