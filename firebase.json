{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "python-functions",
      "runtime": "python312"
    },
    {
      "source": "firebase/functions",
      "codebase": "story-functions",
      "runtime": "nodejs20"
    },
    {
      "source": "cloud-functions/music-payouts",
      "codebase": "music-payouts",
      "runtime": "nodejs20"
    },
    {
      "source": "cloud-functions/agi-scheduler",
      "codebase": "agi-scheduler",
      "runtime": "nodejs20"
    },
    {
      "source": "cloud-functions/ai-proxy",
      "codebase": "ai-proxy",
      "runtime": "nodejs20"
    },
    {
      "source": "functions-v2",
      "codebase": "platform-functions",
      "runtime": "python312"
    },
    {
      "source": "functions-v3",
      "codebase": "platform-functions-v3",
      "runtime": "python312"
    },
    {
      "source": "functions-v4",
      "codebase": "platform-functions-v4",
      "runtime": "python312"
    }
  ],
  "hosting": {
    "public": "web-v2/out",
    "ignore": [
      "firebase.json",
      "**/.DS_Store",
      "**/.git/**",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/studio/videos/*/edit",
        "destination": "/studio/videos/_fallback/edit/index.html"
      },
      {
        "source": "/studio/videos/*/captions",
        "destination": "/studio/videos/_fallback/captions/index.html"
      },
      {
        "source": "/studio/videos/*/chapters",
        "destination": "/studio/videos/_fallback/chapters/index.html"
      },
      {
        "source": "/studio/videos/*/end-screens",
        "destination": "/studio/videos/_fallback/end-screens/index.html"
      },
      {
        "source": "/studio/videos/*",
        "destination": "/studio/videos/_fallback/edit/index.html"
      },
      {
        "source": "/live/*",
        "destination": "/live/_fallback/index.html"
      },
      {
        "source": "/profile/*",
        "destination": "/profile/_fallback/index.html"
      },
      {
        "source": "/product/*",
        "destination": "/product/_fallback/index.html"
      },
      {
        "source": "/playlists/*",
        "destination": "/playlists/_fallback/index.html"
      },
      {
        "source": "/medals/match/*/spectate",
        "destination": "/medals/match/_fallback/spectate/index.html"
      },
      {
        "source": "/medals/match/**",
        "destination": "/medals/match/_fallback/index.html"
      },
      {
        "source": "/watch/**",
        "destination": "/watch/_fallback/index.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy/index.html"
      },
      {
        "source": "/terms",
        "destination": "/terms/index.html"
      },
      {
        "source": "/support",
        "destination": "/support/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          }
        ]
      }
    ]
  }
}
