rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return isSignedIn() ? request.auth.uid : null;
    }
    function hasRole(role) {
      return isSignedIn() && (
        request.auth.token.role == role ||
        (request.auth.token.roles != null && role in request.auth.token.roles)
      );
    }
    function isAdmin() { return hasRole('admin'); }
    function isOwner(ownerId) { return isSignedIn() && ownerId == uid(); }

    // ── Security helpers ──────────────────────────────────────────────────

    // Block suspended / permanently-banned accounts
    function isNotBanned() {
      return isSignedIn() &&
        !exists(/databases/$(database)/documents/security_bans/$(request.auth.uid));
    }

    // Reject strings longer than maxLen to prevent oversized payloads
    function strLen(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // Validate that a string field does NOT contain obvious script-injection markers
    function noScript(val) {
      return val is string
        && !val.matches('(?i).*<script.*')
        && !val.matches('(?i).*javascript:.*')
        && !val.matches('(?i).*onerror\\s*=.*')
        && !val.matches('(?i).*onload\\s*=.*');
    }

    // Combined safe text: bounded length + no XSS
    function safeText(val, maxLen) {
      return strLen(val, maxLen) && noScript(val);
    }

    // Only allow known visibility values
    function validVisibility(v) {
      return v == 'public' || v == 'private' || v == 'unlisted';
    }

    // ── Users ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && isNotBanned() && userId == uid()
        && safeText(request.resource.data.get('displayName', ''), 100)
        && safeText(request.resource.data.get('bio', ''), 500);
      allow update: if (isOwner(userId) || isAdmin()) && isNotBanned()
        && safeText(request.resource.data.get('displayName', ''), 100)
        && safeText(request.resource.data.get('bio', ''), 500)
        // Prevent uid spoofing
        && request.resource.data.uid == resource.data.uid;
      allow delete: if (isOwner(userId) || isAdmin()) && isNotBanned();

      match /subscriptions/{channelId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isNotBanned()
          && request.resource.data.ownerUid == uid();
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /subscribers/{fanUid} {
        allow read: if true;
        allow create: if isSignedIn() && isNotBanned() && fanUid == uid();
        allow delete: if isSignedIn() && (fanUid == uid() || isAdmin());
      }

      match /search_history/{itemId} {
        allow read: if isSignedIn() && uid() == userId;
        allow create, update: if isSignedIn() && isNotBanned() && uid() == userId;
        allow delete: if isSignedIn() && uid() == userId;
      }
    }

    // ── Security bans (admin-write, no self-read) ─────────────────────────
    match /security_bans/{banUid} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Security threat log (Cloud Functions write only) ──────────────────
    match /security_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false; // only Cloud Functions can write
    }

    // ── Channels ──────────────────────────────────────────────────────────
    match /channels/{channelId} {
      allow read: if resource.data.visibility == 'public' || isOwner(resource.data.ownerUid) || isAdmin();
      allow create: if isSignedIn() && isNotBanned()
        && request.resource.data.ownerUid == uid()
        && safeText(request.resource.data.get('name', ''), 100)
        && safeText(request.resource.data.get('description', ''), 2000)
        && validVisibility(request.resource.data.get('visibility', 'public'));
      allow update: if (isOwner(resource.data.ownerUid) || isAdmin()) && isNotBanned()
        && safeText(request.resource.data.get('name', ''), 100)
        && safeText(request.resource.data.get('description', ''), 2000);
      allow delete: if (isOwner(resource.data.ownerUid) || isAdmin()) && isNotBanned();
    }

    // ── Videos ────────────────────────────────────────────────────────────
    match /videos/{videoId} {
      allow read: if resource.data.visibility == 'public' || isOwner(resource.data.ownerUid) || isAdmin();
      allow create: if isSignedIn() && isNotBanned()
        && request.resource.data.ownerUid == uid()
        && safeText(request.resource.data.get('title', ''), 200)
        && safeText(request.resource.data.get('description', ''), 5000)
        && validVisibility(request.resource.data.get('visibility', 'public'));
      allow update: if isNotBanned() && (
        isAdmin() || (
          isOwner(resource.data.ownerUid)
          && request.resource.data.adSettings == resource.data.adSettings
          && safeText(request.resource.data.get('title', ''), 200)
          && safeText(request.resource.data.get('description', ''), 5000)
        )
      );
      allow delete: if (isOwner(resource.data.ownerUid) || isAdmin()) && isNotBanned();

      // Comments
      match /comments/{commentId} {
        function parentIsPublic() {
          return get(/databases/$(database)/documents/videos/$(videoId)).data.visibility == 'public';
        }
        allow read: if parentIsPublic() || isAdmin()
          || isOwner(get(/databases/$(database)/documents/videos/$(videoId)).data.ownerUid);
        allow create: if isSignedIn() && isNotBanned() && parentIsPublic()
          && request.resource.data.authorUid == uid()
          && safeText(request.resource.data.get('text', ''), 2000);
        allow update, delete: if isSignedIn() && isNotBanned() && (
          request.resource.data.authorUid == uid() ||
          resource.data.authorUid == uid() ||
          isAdmin()
        );
      }

      // Likes
      match /likes/{likeUid} {
        allow read: if true;
        allow create: if isSignedIn() && isNotBanned() && likeUid == uid();
        allow delete: if isSignedIn() && (likeUid == uid() || isAdmin());
      }

      // View shards (Cloud Functions only)
      match /view_shards/{shardId} {
        allow read: if false;
        allow write: if false;
      }
    }

    // ── Shorts ────────────────────────────────────────────────────────────
    match /shorts/{shortId} {
      allow read: if resource.data.visibility == 'public' || isOwner(resource.data.ownerUid) || isAdmin();
      allow create: if isSignedIn() && isNotBanned()
        && request.resource.data.ownerUid == uid()
        && safeText(request.resource.data.get('title', ''), 200)
        && validVisibility(request.resource.data.get('visibility', 'public'));
      allow update, delete: if (isOwner(resource.data.ownerUid) || isAdmin()) && isNotBanned();
    }

    // ── Playlists ─────────────────────────────────────────────────────────
    match /playlists/{playlistId} {
      allow read: if resource.data.visibility == 'public' || isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && isNotBanned()
        && request.resource.data.userId == uid()
        && safeText(request.resource.data.get('title', ''), 200)
        && validVisibility(request.resource.data.get('visibility', 'public'));
      allow update, delete: if (isOwner(resource.data.userId) || isAdmin()) && isNotBanned();

      match /videos/{videoId} {
        allow read: if get(/databases/$(database)/documents/playlists/$(playlistId)).data.visibility == 'public'
          || isOwner(get(/databases/$(database)/documents/playlists/$(playlistId)).data.userId)
          || isAdmin();
        allow write: if (isOwner(get(/databases/$(database)/documents/playlists/$(playlistId)).data.userId) || isAdmin()) && isNotBanned();
      }
    }

    // ── Reports ───────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isSignedIn() && isNotBanned()
        && safeText(request.resource.data.get('reason', ''), 1000);
      allow read, update, delete: if isAdmin();
    }

    // ── Content Reports (video/comment/user reporting) ──────────────────
    match /content_reports/{reportId} {
      allow create: if isSignedIn() && isNotBanned()
        && request.resource.data.reporterId == uid()
        && safeText(request.resource.data.get('reason', ''), 500);
      allow read, update, delete: if isAdmin();
    }

    // ── Earnings ──────────────────────────────────────────────────────────
    match /earnings/{channelId} {
      allow read: if isAdmin() || (isSignedIn() && uid() == get(/databases/$(database)/documents/channels/$(channelId)).data.ownerUid);
      allow write: if isAdmin();
    }

    // ── Growth configs (admin only) ───────────────────────────────────────
    match /growth/{docPath=**} {
      allow read, write: if isAdmin();
    }

    // ── Ads configs (admin only) ──────────────────────────────────────────
    match /ads/{docPath=**} {
      allow read, write: if isAdmin();
    }

    // ── Live Streams ──────────────────────────────────────────────────────
    match /live_streams/{streamId} {
      allow read: if true;
      allow create: if isSignedIn() && isNotBanned()
        && request.resource.data.creatorId == uid()
        && safeText(request.resource.data.get('title', ''), 200);
      allow update: if isSignedIn() && isNotBanned() && (resource.data.creatorId == uid() || isAdmin());
      allow delete: if isSignedIn() && (resource.data.creatorId == uid() || isAdmin());

      match /chat/{messageId} {
        allow read: if true;
        allow create: if isSignedIn() && isNotBanned()
          && request.resource.data.userId == uid()
          && safeText(request.resource.data.get('text', ''), 500);
        allow delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      }
    }

    // ── Stories ───────────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.creatorId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn()
        && (resource.data.creatorId == request.auth.uid || isAdmin());
    }

    // ── Story collections index (one doc per creator, updated on story post) ─
    match /story-collections/{creatorId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == creatorId;
    }

    // ── Watch Later (user-scoped) ──────────────────────────────────────────
    match /watch_later/{userId}/items/{itemId} {
      allow read: if isSignedIn() && uid() == userId;
      allow create: if isSignedIn() && isNotBanned() && uid() == userId;
      allow update: if isSignedIn() && isNotBanned() && uid() == userId;
      allow delete: if isSignedIn() && (uid() == userId || isAdmin());
    }

    // ── Community Posts ─────────────────────────────────────────────────────
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isNotBanned()
        && request.resource.data.creatorId == uid()
        && safeText(request.resource.data.get('content', ''), 5000);
      allow update: if isSignedIn() && isNotBanned() && (resource.data.creatorId == uid() || isAdmin());
      allow delete: if isSignedIn() && (resource.data.creatorId == uid() || isAdmin());

      match /likes/{likeUid} {
        allow read: if true;
        allow create: if isSignedIn() && isNotBanned() && likeUid == uid();
        allow delete: if isSignedIn() && (likeUid == uid() || isAdmin());
      }

      match /votes/{voteUid} {
        allow read: if true;
        allow create, update: if isSignedIn() && isNotBanned() && voteUid == uid();
        allow delete: if isSignedIn() && (voteUid == uid() || isAdmin());
      }
    }

    // ── History (user-scoped) ───────────────────────────────────────────────
    match /history/{userId}/items/{itemId} {
      allow read: if isSignedIn() && uid() == userId;
      allow create, update: if isSignedIn() && isNotBanned() && uid() == userId;
      allow delete: if isSignedIn() && (uid() == userId || isAdmin());
    }

    // ── Notifications (user-scoped, read-only to owner) ───────────────────
    match /notifications/{userId}/items/{itemId} {
      allow read: if isSignedIn() && uid() == userId;
      allow write: if false; // Cloud Functions only
    }
  }
}


