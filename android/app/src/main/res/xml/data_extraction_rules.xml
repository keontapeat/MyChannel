<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules (android:dataExtractionRules), used on Android 12 (API 31) and above.
  Controls both cloud backup and device-to-device transfer.
  Sensitive auth/session data is excluded from both to avoid leaking tokens.
  See: https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="mychannel_secure_prefs.xml" />
        <exclude domain="database" path="mychannel.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mychannel_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
