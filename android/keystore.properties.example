# Android release signing — COPY this file to `keystore.properties` and fill in real values.
# `keystore.properties` is gitignored. NEVER commit the real file or the .jks keystore.
#
# 1. Generate an upload keystore (choose your own strong passwords when prompted):
#      keytool -genkeypair -v \
#        -keystore android/app/upload-keystore.jks \
#        -keyalg RSA -keysize 2048 -validity 10000 \
#        -alias mychannel-upload
#
# 2. Copy this file:  cp android/keystore.properties.example android/keystore.properties
# 3. Fill in the values below to match what you set in step 1.
# 4. Build the release bundle:  ./gradlew :app:bundleRelease
#    Output: android/app/build/outputs/bundle/release/app-release.aab

storeFile=app/upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=mychannel-upload
keyPassword=CHANGE_ME
