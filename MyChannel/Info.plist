	<!-- ═══════════════════════════════════════════════════════════════ -->
	<!-- 📸 CAMERA & MEDIA CAPTURE -->
	<!-- ═══════════════════════════════════════════════════════════════ -->
	
	<key>NSCameraUsageDescription</key>
	<string>MyChannel needs camera access to record videos, take photos for thumbnails, enable AR face filters, scan QR codes, and power live streaming.</string>
	
	<key>NSMicrophoneUsageDescription</key>
	<string>MyChannel needs microphone access to record audio for your videos, enable voice search, capture live streams, and power real-time voice effects.</string>
	
	<!-- ═══════════════════════════════════════════════════════════════ -->
	<!-- 🖼️ PHOTO LIBRARY -->
	<!-- ═══════════════════════════════════════════════════════════════ -->
	
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MyChannel needs photo library access to upload videos, images, and select thumbnails from your device.</string>
	
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>MyChannel needs permission to save videos, thumbnails, and downloaded content to your photo library.</string>
	
	<!-- ═══════════════════════════════════════════════════════════════ -->
	<!-- 🎤 SPEECH & VOICE -->
	<!-- ═══════════════════════════════════════════════════════════════ -->
	
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>MyChannel uses speech recognition to generate automatic captions, enable voice search, and power real-time transcription.</string>
	
	<!-- ═══════════════════════════════════════════════════════════════ -->
	<!-- 📍 LOCATION - ALL MODES -->
	<!-- ═══════════════════════════════════════════════════════════════ -->
	
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>MyChannel uses your location to show relevant local content, geo-tag your videos, and discover nearby creators and events.</string>
	
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>MyChannel uses your location to show relevant local content, continue location-based features while recording or streaming, and send location-based notifications.</string>
	
	<key>NSLocationAlwaysUsageDescription</key>
	<string>MyChannel uses your location in the background to notify you about nearby live events and trending content in your area.</string>
	
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>NearbyContent</key>
		<string>MyChannel needs your precise location to show content from creators near you.</string>
		<key>GeoTagging</key>
		<string>MyChannel needs your precise location to tag your video with the exact filming location.</string>
	</dict>
	
	<!-- ═══════════════════════════════════════════════════════════════ -->
	<!-- 🔐 SECURITY & AUTHENTICATION -->
	<!-- ═══════════════════════════════════════════════════════════════ -->
	
	<key>NSFaceIDUsageDescription</key>
	<string>MyChannel uses Face ID to securely authenticate payments, protect your account, and enable quick login.</string>
	
	<!-- ═══════════════════════════════════════════════════════════════ -->
	<!-- 👥 CONTACTS & SOCIAL -->
	<!-- ═══════════════════════════════════════════════════════════════ -->
	
	<key>NSContactsUsageDescription</key>
	<string>MyChannel can access your contacts to help you find and invite friends, discover creators you may know, and share videos easily.</string>
	
	<!-- ═══════════════════════════════════════════════════════════════ -->
	<!-- 📅 CALENDAR & REMINDERS -->
	<!-- ═══════════════════════════════════════════════════════════════ -->
	
	<key>NSCalendarsUsageDescription</key>
	<string>MyChannel can add video premieres, live stream schedules, and creator events to your calendar so you never miss content.</string>
	
	<key>NSRemindersUsageDescription</key>
	<string>MyChannel can create reminders for upcoming premieres, live streams, and content you want to watch later.</string>
	
	<!-- ═══════════════════════════════════════════════════════════════ -->
	<!-- 🎧 BLUETOOTH & AUDIO DEVICES -->
	<!-- ═══════════════════════════════════════════════════════════════ -->
	
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>MyChannel uses Bluetooth to detect audio devices like AirPods for seamless playback control, auto-pause features, and connect to gaming controllers.</string>
	
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>MyChannel uses Bluetooth to connect to external microphones, cameras, professional audio equipment, and gaming peripherals for content creation.</string>
	
	<!-- ═══════════════════════════════════════════════════════════════ -->
	<!-- 📡 LOCAL NETWORK (Chromecast, AirPlay, Smart TVs) -->
	<!-- ═══════════════════════════════════════════════════════════════ -->
	
	<key>NSLocalNetworkUsageDescription</key>
	<string>MyChannel uses local network access to discover and connect to Chromecast, AirPlay devices, smart TVs, gaming consoles, and other streaming devices in your home.</string>
	
	<!-- ═══════════════════════════════════════════════════════════════ -->
	<!-- 🎤 SIRI & VOICE CONTROL -->
	<!-- ═══════════════════════════════════════════════════════════════ -->
	
	<key>NSSiriUsageDescription</key>
	<string>MyChannel uses Siri to let you search for videos, control playback, start live streams, and navigate the app with your voice.</string>
	
	<!-- ═══════════════════════════════════════════════════════════════ -->
	<!-- 🎵 APPLE MUSIC -->
	<!-- ═══════════════════════════════════════════════════════════════ -->
	
	<key>NSAppleMusicUsageDescription</key>
	<string>MyChannel accesses Apple Music to add licensed music to your videos, detect copyrighted content, and sync your music preferences.</string>
	
	<!-- ═══════════════════════════════════════════════════════════════ -->
	<!-- 🏃 MOTION & FITNESS -->
	<!-- ═══════════════════════════════════════════════════════════════ -->
	
	<key>NSMotionUsageDescription</key>
	<string>MyChannel uses motion data to provide immersive viewing experiences, track workout progress during fitness videos, enable AR features, and detect device orientation for video recording.</string>
	
	<!-- ═══════════════════════════════════════════════════════════════ -->
	<!-- 🏥 HEALTH - FITNESS CONTENT -->
	<!-- ═══════════════════════════════════════════════════════════════ -->
	
	<key>NSHealthShareUsageDescription</key>
	<string>MyChannel reads your workout and activity data to track your progress during fitness videos, provide personalized workout recommendations, and sync with fitness challenges.</string>
	
	<key>NSHealthUpdateUsageDescription</key>
	<string>MyChannel saves workout data from fitness videos to your Health app, including calories burned, exercise minutes, and workout types to track your fitness journey.</string>
	
	<key>NSHealthClinicalHealthRecordsShareUsageDescription</key>
	<string>MyChannel can access your health records to provide personalized fitness and wellness content recommendations.</string>
	
	<!-- ═══════════════════════════════════════════════════════════════ -->
	<!-- 🏠 HOMEKIT - SMART HOME -->
	<!-- ═══════════════════════════════════════════════════════════════ -->
	
	<key>NSHomeKitUsageDescription</key>
	<string>MyChannel can control your smart home devices to dim lights during video playback, cast to smart TVs, and create an immersive viewing experience.</string>
	
	<!-- ═══════════════════════════════════════════════════════════════ -->
